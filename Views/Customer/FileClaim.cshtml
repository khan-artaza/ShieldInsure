@model Final_Insure.DTOs.CreateClaimDTO

@{
    ViewData["Title"] = "File a Claim";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header text-white" style="background: linear-gradient(135deg, #0c387a, #1856b5);">
                    <h5 class="mb-0">Register a New Claim</h5>
                </div>
                <div class="card-body p-4">

                    <!-- ENCTYPE IS REQUIRED FOR FILE UPLOADS -->
                    <form asp-action="FileClaim" method="post" enctype="multipart/form-data">

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="PolicyId" class="form-label fw-bold">Select Policy</label>
                                <select asp-for="PolicyId" class="form-select" required>
                                    <option value="">-- Choose Active Policy --</option>
                                    @if (ViewBag.ActivePolicies != null)
                                    {
                                        foreach (var policy in ViewBag.ActivePolicies)
                                        {
                                            <option value="@policy.PolicyId">@policy.PolicyType - @policy.PolicyNumber</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="PolicyId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="ClaimType" class="form-label fw-bold">Type of Claim</label>
                                <select asp-for="ClaimType" class="form-select" required>
                                    <option value="">-- Select --</option>
                                    <option value="Accident">Accident</option>
                                    <option value="Theft">Theft</option>
                                    <option value="Natural Disaster">Natural Disaster</option>
                                    <option value="Other">Other</option>
                                </select>
                                <span asp-validation-for="ClaimType" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="ClaimAmount" class="form-label fw-bold">Requested Amount ($)</label>
                                <input asp-for="ClaimAmount" type="number" step="0.01" class="form-control" placeholder="e.g. 1500.00" required />
                                <span asp-validation-for="ClaimAmount" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="IncidentDate" class="form-label fw-bold">Date of Incident</label>
                                <input asp-for="IncidentDate" type="date" class="form-control" required />
                                <span asp-validation-for="IncidentDate" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- NEW: Accident Address Field -->
                        <div class="mb-3">
                            <label asp-for="AccidentAddress" class="form-label fw-bold">Accident Location / Address</label>
                            <input asp-for="AccidentAddress" class="form-control" placeholder="123 Main St, City, State" required />
                            <span asp-validation-for="AccidentAddress" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-bold">Incident Description</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Please describe exactly what happened..." required></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <hr class="mb-4" />
                        <h6 class="fw-bold text-muted mb-3"><i class="bi bi-paperclip"></i> Required Evidence & Documents</h6>

                        <!-- NEW: File Upload Fields -->
                        <div class="mb-3">
                            <label asp-for="DamagePhoto" class="form-label fw-bold">Upload Damage Photo (JPG/PNG)</label>
                            <input asp-for="DamagePhoto" type="file" class="form-control" accept="image/*" required />
                            <span asp-validation-for="DamagePhoto" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="FIRDocument" class="form-label fw-bold">Upload Police FIR (PDF/Image)</label>
                            <input asp-for="FIRDocument" type="file" class="form-control" accept=".pdf,image/*" required />
                            <span asp-validation-for="FIRDocument" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="GarageReceipt" class="form-label fw-bold">Garage Estimate / Receipt (Optional)</label>
                            <input asp-for="GarageReceipt" type="file" class="form-control" accept=".pdf,image/*" />
                            <span asp-validation-for="GarageReceipt" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between mt-2">
                            <a asp-action="Dashboard" class="btn btn-outline-secondary px-4">Cancel</a>
                            <button type="submit" class="btn btn-primary fw-bold px-5 shadow-sm">Submit Claim</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>