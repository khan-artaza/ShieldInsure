@model IEnumerable<Final_Insure.Models.User>
@{
    ViewData["Title"] = "System Administration";
}

<div class="container-fluid py-3">
    <!-- Operational Dark Theme Wrapper -->
    <div class="p-4 rounded-4 shadow-lg" style="background: linear-gradient(145deg, #0f172a, #020617); border: 1px solid #1e293b; min-height: 85vh;">

        <!-- Ops Header -->
        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-4" style="border-color: #1e293b !important;">
            <div>
                <h3 class="fw-bolder mb-1" style="color: #f8fafc; letter-spacing: -0.5px;">
                    <i class="fa-solid fa-server me-2" style="color: #38bdf8;"></i> Super Admin Ops Center
                </h3>
                <p class="mb-0" style="color: #94a3b8; font-family: monospace; font-size: 0.85rem;">
                    SYS_ADMIN // ACCESS_MANAGEMENT & POLICY_DEPLOYMENT
                </p>
            </div>
            <div>
                <a asp-action="CreatePolicy" class="btn fw-bold shadow text-dark" style="background-color: #38bdf8; border: none; letter-spacing: 0.5px;">
                    <i class="fa-solid fa-cloud-arrow-up me-2"></i> Deploy New Policy
                </a>
            </div>
        </div>

        <!-- Terminal Alerts -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-dismissible fade show border-0 rounded-3 mb-4" role="alert" style="background-color: rgba(16, 185, 129, 0.1); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.2) !important;">
                <i class="fa-solid fa-shield-check me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Data Terminal (Card) -->
        <div class="card border-0 shadow-none rounded-3" style="background-color: #0f172a; border: 1px solid #1e293b !important;">
            <div class="card-header py-3 d-flex align-items-center" style="background-color: #1e293b; border-bottom: 1px solid #334155;">
                <div style="width: 10px; height: 10px; border-radius: 50%; background-color: #10b981; margin-right: 12px; box-shadow: 0 0 10px #10b981; animation: pulse 2s infinite;"></div>
                <h6 class="mb-0 fw-bold" style="color: #e2e8f0; letter-spacing: 1px; font-size: 0.85rem;">STAFF IDENTITY & ACCESS MATRIX</h6>
            </div>
            <div class="card-body p-0">
                @if (Model != null && Model.Any())
                {
                    <div class="table-responsive">
                        <!-- Bootstrap table-dark overridden with custom sleek dark styles -->
                        <table class="table table-hover table-dark align-middle mb-0" style="background-color: transparent; --bs-table-bg: transparent; --bs-table-hover-bg: rgba(255, 255, 255, 0.03);">
                            <thead style="background-color: #0f172a;">
                                <tr>
                                    <th class="ps-4" style="color: #64748b; font-size: 0.75rem; border-bottom: 1px solid #334155; padding-top: 1rem; padding-bottom: 1rem;">Identity Name</th>
                                    <th style="color: #64748b; font-size: 0.75rem; border-bottom: 1px solid #334155;">Comm Protocol (Email)</th>
                                    <th style="color: #64748b; font-size: 0.75rem; border-bottom: 1px solid #334155;">Clearance Level</th>
                                    <th style="color: #64748b; font-size: 0.75rem; border-bottom: 1px solid #334155;">Network Status</th>
                                    <th class="text-end pe-4" style="color: #64748b; font-size: 0.75rem; border-bottom: 1px solid #334155;">Override Command</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var staff in Model)
                                {
                                    <tr style="border-bottom: 1px solid #1e293b;">
                                        <td class="ps-4 fw-bold" style="color: #f1f5f9; padding-top: 1rem; padding-bottom: 1rem;">@staff.Username</td>
                                        <td style="color: #94a3b8; font-family: monospace; font-size: 0.9rem;">@staff.Email</td>
                                        <td>
                                            <span class="badge rounded-pill px-3" style="background-color: #1e293b; color: #cbd5e1; border: 1px solid #475569;">
                                                <i class="fa-solid fa-id-card-clip me-1 text-muted"></i> @staff.Role
                                            </span>
                                        </td>
                                        <td>
                                            @if (staff.IsApproved)
                                            {
                                                <span class="badge rounded-pill px-3 py-2" style="background-color: rgba(16, 185, 129, 0.1); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.2);">
                                                    <i class="fa-solid fa-circle-dot me-1" style="font-size: 0.5rem; vertical-align: middle;"></i> SECURE / ACTIVE
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge rounded-pill px-3 py-2" style="background-color: rgba(245, 158, 11, 0.1); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.2);">
                                                    <i class="fa-solid fa-triangle-exclamation me-1"></i> PENDING AUTH
                                                </span>
                                            }
                                        </td>
                                        <td class="text-end pe-4">
                                            @if (!staff.IsApproved)
                                            {
                                                <form asp-action="ApproveStaff" method="post" class="d-inline">
                                                    <input type="hidden" name="userId" value="@staff.UserId" />
                                                    <button type="submit" class="btn btn-sm fw-bold me-2" style="background-color: rgba(16, 185, 129, 0.1); color: #34d399; border: 1px solid #34d399; letter-spacing: 1px;">
                                                        GRANT
                                                    </button>
                                                </form>
                                                <form asp-action="RejectStaff" method="post" class="d-inline">
                                                    <input type="hidden" name="userId" value="@staff.UserId" />
                                                    <button type="submit" class="btn btn-sm fw-bold" style="background-color: rgba(239, 68, 68, 0.1); color: #f87171; border: 1px solid #f87171; letter-spacing: 1px;">
                                                        DENY
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <span style="color: #64748b; font-family: monospace; font-size: 0.8rem;">
                                                    <i class="fa-solid fa-lock text-muted me-1"></i> NO_ACTION
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-5 text-center" style="color: #64748b;">
                        <i class="fa-solid fa-radar fs-1 mb-3 d-block" style="color: #334155;"></i>
                        <h6 class="fw-bold" style="color: #94a3b8; letter-spacing: 1px;">NO IDENTITIES DETECTED</h6>
                        <p class="small mb-0" style="font-family: monospace;">System query returned 0 staff records.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    /* Small CSS animation for the active indicator light */
    @@keyframes pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
        }

        70% {
            box-shadow: 0 0 0 10px rgba(16, 185, 129, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
        }
    }
</style>