@model Final_Insure.Models.Policy
@{
    ViewData["Title"] = "Policy Details";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="card card-shadow-md overflow-hidden">
            <div class="card-header text-white"
                 style="background:linear-gradient(135deg,#0c387a,#1856b5); border-bottom:none!important;">
                <h5 class="mb-0 fw-700">
                    <i class="fa-solid fa-shield-halved me-2"></i> Policy Details: @Model.PolicyNumber
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="detail-row">
                    <span class="detail-label">Policy Type</span>
                    <span class="detail-value fw-600">@Model.PolicyType Insurance</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Coverage Limit</span>
                    <span class="detail-value fw-bold text-success">$@Model.CoverageAmount.ToString("N0")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Monthly Premium</span>
                    <span class="detail-value fw-600">$@Model.PremiumAmount.ToString("0.00")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Vehicle RC</span>
                    <span class="detail-value text-muted">@(Model.VehicleRC ?? "N/A")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Validity</span>
                    <span class="detail-value text-muted">@Model.StartDate.ToString("MMM dd, yyyy") — @Model.EndDate.ToString("MMM dd, yyyy")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Status</span>
                    <span class="detail-value"><span class="badge badge-soft-success rounded-pill px-3">Active</span></span>
                </div>
                <div class="mt-4 d-grid">
                    <a asp-action="Dashboard" class="btn btn-outline-primary fw-bold py-2">
                        <i class="fa-solid fa-arrow-left me-2"></i> Back to Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
