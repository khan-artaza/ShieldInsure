@model Final_Insure.DTOs.SubmitFraudCheckDTO
@using Final_Insure.Models
@{
    ViewData["Title"] = "Submit Fraud Check";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var claim = ViewBag.ClaimData as Claim;
    var assessment = ViewBag.AssessmentData as Assessment;
    string barColor = "bg-success";
    if (Model.FraudScore >= 80) barColor = "bg-danger";
    else if (Model.FraudScore >= 50) barColor = "bg-warning";
}

<div class="page-header">
    <div>
        <h1 class="page-header-title text-danger">Fraud Investigation Report</h1>
        <p class="page-header-subtitle">Review case file data and submit final verdict for Claim #@Model.ClaimId.</p>
    </div>
    <a asp-action="Dashboard" class="btn btn-outline-secondary fw-600">
        <i class="fa-solid fa-arrow-left me-2"></i> Cancel &amp; Back
    </a>
</div>

<div class="row g-4">
    <!-- Left: Case File -->
    <div class="col-lg-5">
        <div class="card card-shadow-md overflow-hidden h-100">
            <div class="card-header bg-dark text-white" style="border-bottom:none!important;">
                <h5 class="mb-0 fw-700">
                    <i class="fa-solid fa-folder-open me-2"></i> Case File Data
                </h5>
            </div>
            <div class="card-body p-4" style="background:#f8fafc;">

                @if (claim != null)
                {
                    <p class="text-muted fw-700 mb-3" style="font-size:.72rem; text-transform:uppercase; letter-spacing:.06em;">1. Policy Details</p>
                    <div class="detail-row">
                        <span class="detail-label">Policy Status</span>
                        <span class="detail-value">
                            <span class="badge @(claim.Policy?.Status == PolicyStatus.Active ? "badge-soft-success" : "badge-soft-danger") rounded-pill px-3">
                                @claim.Policy?.Status
                            </span>
                        </span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Days Since Purchase</span>
                        <span class="detail-value fw-600">
                            @(claim.Policy != null ? Math.Round((claim.IncidentDate - claim.Policy.StartDate).TotalDays) : "Unknown") days
                        </span>
                    </div>
                    <hr class="opacity-25 my-3">
                }

                @if (assessment != null)
                {
                    <p class="text-muted fw-700 mb-3" style="font-size:.72rem; text-transform:uppercase; letter-spacing:.06em;">2. Surveyor Field Report</p>
                    <div class="p-3 mb-3 rounded-3 border @(assessment.AccidentMatchesDescription ? "" : "border-danger")"
                         style="background:@(assessment.AccidentMatchesDescription ? "#f0fdf4" : "#fef2f2");">
                        <strong style="font-size:.875rem;">Damage Matches Story?</strong><br />
                        @if (assessment.AccidentMatchesDescription)
                        {
                            <span class="text-success fw-600" style="font-size:.875rem;">
                                <i class="fa-solid fa-check-circle me-1"></i> Yes, matches customer description.
                            </span>
                        }
                        else
                        {
                            <span class="text-danger fw-600" style="font-size:.875rem;">
                                <i class="fa-solid fa-triangle-exclamation me-1"></i> NO. Flagged as highly suspicious!
                            </span>
                        }
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Assessed Cost</span>
                        <span class="detail-value fw-600">$@assessment.AssessedAmount.ToString("N0")</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Surveyor Notes</span>
                        <span class="detail-value text-muted" style="font-size:.85rem;">@(assessment.AssessmentRemarks ?? "None")</span>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning">
                        <i class="fa-solid fa-circle-info me-2"></i> Surveyor report missing.
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Right: Audit Form -->
    <div class="col-lg-7">
        <div class="card card-shadow-lg overflow-hidden">
            <div class="card-header bg-danger text-white" style="border-bottom:none!important;">
                <h5 class="mb-0 fw-700">
                    <i class="fa-solid fa-gavel me-2"></i> Official Verdict
                </h5>
            </div>
            <div class="card-body p-4">

                <!-- Fraud Score Visualizer -->
                <div class="p-4 border rounded-3 mb-4" style="background:rgba(239,68,68,.04);">
                    <div class="d-flex justify-content-between align-items-end mb-2">
                        <span class="fw-700 text-dark">System Fraud Score</span>
                        <h3 class="mb-0 fw-800 @(Model.FraudScore >= 80 ? "text-danger" : "text-dark")">
                            @Model.FraudScore<span class="text-muted fw-400" style="font-size:1rem;">/100</span>
                        </h3>
                    </div>
                    <div class="progress" style="height:10px; border-radius:8px;">
                        <div class="progress-bar progress-bar-striped progress-bar-animated @barColor"
                             role="progressbar"
                             style="width:@Model.FraudScore%;"
                             aria-valuenow="@Model.FraudScore" aria-valuemin="0" aria-valuemax="100">
                        </div>
                    </div>
                </div>

                <form asp-action="SubmitFraudCheck" method="post">
                    <input type="hidden" asp-for="ClaimId" />

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="FraudScore" class="form-label">Calculated Risk Score</label>
                            <div class="input-group">
                                <input asp-for="FraudScore" type="number" class="form-control fw-700 bg-light" readonly />
                                <span class="input-group-text">/&nbsp;100</span>
                            </div>
                            <span asp-validation-for="FraudScore" class="text-danger" style="font-size:.8rem;"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="RiskFlag" class="form-label">Risk Level <span class="text-danger">*</span></label>
                            <select asp-for="RiskFlag" class="form-select fw-700"
                                    asp-items="Html.GetEnumSelectList<RiskFlag>()"
                                    style="border-color:#ef4444!important;">
                                <option value="">— Select Risk Level —</option>
                            </select>
                            <span asp-validation-for="RiskFlag" class="text-danger" style="font-size:.8rem;"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="InvestigatorRemarks" class="form-label">Investigator Remarks <span class="text-danger">*</span></label>
                        <textarea asp-for="InvestigatorRemarks" class="form-control" rows="4"
                                  placeholder="Detail the background check findings..." required></textarea>
                        <span asp-validation-for="InvestigatorRemarks" class="text-danger" style="font-size:.8rem;"></span>
                    </div>

                    <div class="alert alert-warning mb-4">
                        <i class="fa-solid fa-triangle-exclamation me-1 text-danger"></i>
                        <span class="text-danger fw-600" style="font-size:.85rem;">
                            Claims with a High/Critical flag or a score of 80+ will be automatically rejected.
                        </span>
                    </div>

                    <button type="submit" class="btn btn-danger w-100 fw-bold py-3">
                        Submit Final Verdict <i class="fa-solid fa-file-signature ms-2"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
