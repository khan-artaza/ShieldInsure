@{
    ViewData["Title"] = "ShieldInsure – India's Trusted Vehicle Insurance";
}

<style>
/* ── INDEX PAGE EXCLUSIVE STYLES ── */
.hero-section {
    background: linear-gradient(135deg, #060e1e 0%, #0c1f3f 55%, #0a2a5e 100%);
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 80px;
    position: relative;
    overflow: hidden;
}
.hero-section::before {
    content: '';
    position: absolute; inset: 0;
    background: radial-gradient(ellipse 70% 60% at 70% 50%, rgba(56,189,248,0.07) 0%, transparent 70%),
                radial-gradient(ellipse 50% 40% at 20% 80%, rgba(99,102,241,0.06) 0%, transparent 60%);
    pointer-events: none;
}
.hero-badge {
    display: inline-flex; align-items: center; gap: 8px;
    background: rgba(56,189,248,0.12);
    border: 1px solid rgba(56,189,248,0.25);
    border-radius: 50px;
    padding: 6px 16px 6px 8px;
    margin-bottom: 1.5rem;
}
.hero-badge-dot {
    width: 22px; height: 22px;
    background: #38bdf8;
    color: #0c1f3f;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.65rem;
    font-weight: 800;
}
.hero-title {
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -2px;
    color: #ffffff;
}
.hero-title span { color: #38bdf8; }
.hero-subtitle {
    font-size: 1.05rem;
    line-height: 1.8;
    color: rgba(255,255,255,0.55);
    max-width: 500px;
}
.hero-btn-primary {
    background: linear-gradient(135deg, #38bdf8, #0284c7);
    border: none;
    color: #0c1f3f;
    font-weight: 800;
    border-radius: 12px;
    padding: 14px 32px;
    font-size: 0.95rem;
    letter-spacing: 0.2px;
    transition: all .25s ease;
    box-shadow: 0 8px 30px rgba(56,189,248,0.35);
}
.hero-btn-primary:hover {
    background: linear-gradient(135deg, #7dd3fc, #38bdf8);
    transform: translateY(-2px);
    box-shadow: 0 14px 40px rgba(56,189,248,0.45);
    color: #0a1628;
}
.hero-btn-secondary {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.15);
    color: rgba(255,255,255,0.85);
    font-weight: 600;
    border-radius: 12px;
    padding: 14px 28px;
    font-size: 0.95rem;
    transition: all .25s ease;
}
.hero-btn-secondary:hover {
    background: rgba(255,255,255,0.12);
    border-color: rgba(255,255,255,0.3);
    color: #fff;
    transform: translateY(-2px);
}
/* Floating stat cards */
.hero-stat-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.hero-stat-card {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.09);
    border-radius: 16px;
    padding: 1.25rem;
    backdrop-filter: blur(10px);
    transition: all .25s ease;
}
.hero-stat-card:hover {
    background: rgba(255,255,255,0.08);
    transform: translateY(-3px);
    border-color: rgba(56,189,248,0.3);
}
.hero-stat-icon {
    width: 42px; height: 42px; border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.1rem; margin-bottom: 10px;
}
.hero-stat-value { font-size: 1.5rem; font-weight: 900; color: #ffffff; line-height: 1; margin-bottom: 2px; }
.hero-stat-label { font-size: 0.72rem; color: rgba(255,255,255,0.45); font-weight: 600; text-transform: uppercase; letter-spacing: .06em; }

/* Trust bar */
.trust-bar { background: rgba(255,255,255,0.03); border-top: 1px solid rgba(255,255,255,0.07); border-bottom: 1px solid rgba(255,255,255,0.07); }
.trust-item { display: flex; flex-direction: column; align-items: center; padding: 1.25rem 0; }
.trust-item h4 { font-size: 1.7rem; font-weight: 900; color: #fff; margin: 0; }
.trust-item span { font-size: .72rem; color: rgba(255,255,255,.45); font-weight: 600; text-transform: uppercase; letter-spacing: .07em; margin-top: 2px; }
.trust-divider { border-right: 1px solid rgba(255,255,255,.08); }

/* Light sections */
.light-section { background: #ffffff; }
.light-section-alt { background: #f8fafc; }
.section-eyebrow {
    font-size: 0.72rem; font-weight: 800; letter-spacing: 0.12em;
    text-transform: uppercase; color: #0c387a;
    display: inline-flex; align-items: center; gap: 8px;
    margin-bottom: 0.75rem;
}
.section-eyebrow::before {
    content: ''; width: 24px; height: 2px;
    background: #38bdf8; border-radius: 2px; display: inline-block;
}
.section-title { font-size: clamp(1.75rem, 3vw, 2.25rem); font-weight: 900; letter-spacing: -1px; color: #0f172a; }

/* Feature cards */
.feat-card {
    background: #fff;
    border: 1px solid #e8eef5;
    border-radius: 18px;
    padding: 2rem;
    transition: all .25s ease;
    height: 100%;
}
.feat-card:hover { transform: translateY(-5px); box-shadow: 0 16px 48px rgba(12,56,122,0.1); border-color: #c7d9f0; }
.feat-icon {
    width: 52px; height: 52px; border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.25rem; margin-bottom: 1.2rem;
}

/* Process steps */
.process-card {
    border-radius: 18px;
    padding: 2rem;
    height: 100%;
    border: 1px solid #e8eef5;
    background: #f8fafc;
    position: relative;
    overflow: hidden;
    transition: all .25s ease;
}
.process-card:hover { transform: translateY(-4px); box-shadow: 0 12px 36px rgba(12,56,122,.08); }
.process-num {
    font-size: 4rem; font-weight: 900; line-height: 1;
    color: #e2e8f0; position: absolute;
    top: 1rem; right: 1.25rem;
    transition: color .3s;
}
.process-card:hover .process-num { color: #bfdbfe; }
.process-card.step-final { background: linear-gradient(135deg, #ecfdf5, #d1fae5); border-color: #a7f3d0; }
.process-card.step-final .process-num { color: #bbf7d0; }

/* FAQ */
.faq-accordion .accordion-button {
    font-weight: 700; font-size: 0.95rem; background: #fff; color: #0f172a;
    padding: 1.25rem 1.5rem; border-radius: 0 !important; box-shadow: none !important;
}
.faq-accordion .accordion-button:not(.collapsed) { color: #0c387a; background: #f0f6ff; }
.faq-accordion .accordion-body { background: #fff; color: #64748b; font-size: .9rem; padding: 0 1.5rem 1.5rem; }
.faq-accordion .accordion-item { border: none; border-bottom: 1px solid #e8eef5; }

/* CTA strip */
.cta-strip {
    background: linear-gradient(135deg, #0c387a, #1a56c4);
    border-radius: 20px;
    padding: 3rem;
}

/* Contact pills */
.contact-pill {
    display: inline-flex; align-items: center; gap: 10px;
    background: #fff; border: 1px solid #e2e8f0;
    border-radius: 50px; padding: 10px 22px;
    font-weight: 700; color: #0f172a; font-size: .9rem;
    text-decoration: none; transition: all .22s ease;
}
.contact-pill:hover { border-color: #0c387a; box-shadow: 0 4px 16px rgba(12,56,122,.1); transform: translateY(-2px); color: #0c387a; }
</style>

