@model Final_Insure.DTOs.RegisterStaffDTO
@using Final_Insure.Models
@{
    ViewData["Title"] = "Staff Onboarding";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-bg">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-sm-11 col-md-8 col-lg-6">

                <div class="text-center mb-4">
                    <a asp-controller="Home" asp-action="Index" class="d-inline-flex align-items-center gap-2 text-decoration-none">
                        <div class="auth-logo-icon">
                            <i class="fa-solid fa-shield-halved text-info fs-5"></i>
                        </div>
                        <span class="fw-800 fs-4 text-white">Shield<span style="color:#38bdf8;">Insure</span></span>
                    </a>
                    <p class="text-muted mt-2 mb-0 tracking-wide" style="font-size:.75rem; letter-spacing:.1em; font-weight:600;">EMPLOYEE IDENTITY GENERATION</p>
                </div>

                <div class="auth-card">
                    <div class="text-center mb-4">
                        <h4 class="fw-800 mb-1">Register New Staff</h4>
                        <p class="text-muted mb-0" style="font-size:.875rem;">Configure department role and access credentials.</p>
                    </div>

                    <div class="alert alert-warning d-flex align-items-center gap-2 mb-4 py-2 px-3">
                        <i class="fa-solid fa-user-lock flex-shrink-0"></i>
                        <span style="font-size:.85rem; font-weight:600;">Requires Super Admin approval before network access is granted.</span>
                    </div>

                    <form asp-controller="Auth" asp-action="RegisterStaff" method="post">
                        <div class="mb-3">
                            <label asp-for="Role" class="form-label">Department Role <span class="text-danger">*</span></label>
                            <select asp-for="Role" class="form-select" asp-items="@(ViewBag.Roles as SelectList)" required>
                                <option value="">-- Select Access Level --</option>
                            </select>
                            <span asp-validation-for="Role" class="text-danger" style="font-size:.8rem;"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Username" class="form-label">Full Name <span class="text-danger">*</span></label>
                            <div class="form-control-icon">
                                <i class="fa-solid fa-user"></i>
                                <input asp-for="Username" class="form-control" placeholder="e.g. Rajesh Kumar" required />
                            </div>
                            <span asp-validation-for="Username" class="text-danger" style="font-size:.8rem;"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Official Email <span class="text-danger">*</span></label>
                            <div class="form-control-icon">
                                <i class="fa-solid fa-envelope"></i>
                                <input asp-for="Email" type="email" class="form-control" placeholder="staff@shieldinsure.com" required />
                            </div>
                            <span asp-validation-for="Email" class="text-danger" style="font-size:.8rem;"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Password" class="form-label">Temporary Password <span class="text-danger">*</span></label>
                            <div class="form-control-icon">
                                <i class="fa-solid fa-key"></i>
                                <input asp-for="Password" type="password" class="form-control" placeholder="Create strong password" required />
                            </div>
                            <span asp-validation-for="Password" class="text-danger" style="font-size:.8rem;"></span>
                        </div>

                        <button type="submit" class="btn w-100 py-3 fw-bold rounded-3 text-white" style="background:#0f172a;">
                            <i class="fa-solid fa-user-plus me-2 text-info"></i> Submit for Approval
                        </button>
                    </form>

                    <div class="text-center mt-4 pt-4 border-top">
                        <p class="text-muted mb-0" style="font-size:.875rem;">
                            Already registered?
                            <a asp-controller="Auth" asp-action="StaffLogin" class="fw-bold text-decoration-none" style="color:#0f172a;">Sign In</a>
                        </p>
                    </div>
                </div>

                <div class="text-center mt-3">
                    <a asp-controller="Home" asp-action="Index" class="text-muted text-decoration-none fw-600" style="font-size:.85rem;">
                        <i class="fa-solid fa-arrow-left me-1"></i> Back to Homepage
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>
