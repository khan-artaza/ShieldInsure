@model Final_Insure.Models.Claim
@using Final_Insure.Models

@{
    ViewData["Title"] = "Review Claim & Assign Surveyor";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Safely cast the available surveyors passed from the controller
    var availableSurveyors = ViewBag.AvailableSurveyors as IEnumerable<dynamic>; // Use dynamic or your actual User model
}

<div class="container-fluid mt-4 px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold" style="color: #1B2B4B;">Claim Review: #CLM-@Model.ClaimId.ToString("D4")</h2>
            <p class="text-muted">Review incident details, inspect evidence, and assign a Surveyor.</p>
        </div>
        <a asp-action="Dashboard" class="btn btn-outline-secondary fw-bold shadow-sm"><i class="fa-solid fa-arrow-left me-2"></i> Back to Dashboard</a>
    </div>

    <div class="row g-4">
        <!-- LEFT SIDE: Claim Details & Documents -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-3 mb-4">
                <div class="card-header text-white bg-dark">
                    <h5 class="mb-0"><i class="fa-solid fa-file-lines me-2"></i> Incident Details</h5>
                </div>
                <div class="card-body p-4">
                    <div class="row mb-3">
                        <div class="col-md-4"><strong>Incident Date:</strong> <br /> @Model.IncidentDate.ToString("MMM dd, yyyy")</div>
                        <div class="col-md-4"><strong>Claim Type:</strong> <br /> @Model.ClaimType</div>
                        <div class="col-md-4"><strong>Requested Payout:</strong> <br /> <span class="text-primary fw-bold fs-5">$@Model.ClaimAmount.ToString("N0")</span></div>
                    </div>
                    <hr />
                    <h6 class="fw-bold">Description of Incident:</h6>
                    <p class="text-muted bg-light p-3 border rounded">@Model.Description</p>
                </div>
            </div>

            <!-- UPLOADED DOCUMENTS -->
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0"><i class="fa-solid fa-paperclip me-2"></i> Uploaded Evidence & Documents</h5>
                </div>
                <div class="card-body p-4">
                    @if (Model.ClaimDocuments != null && Model.ClaimDocuments.Any())
                    {
                        <div class="list-group">
                            @foreach (var doc in Model.ClaimDocuments)
                            {
                                <a href="@doc.FilePath" target="_blank" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                    <div>
                                        <i class="fa-solid fa-file-image text-primary me-2"></i> <strong>@doc.DocumentName</strong><br />
                                        <small class="text-muted">Uploaded on @doc.UploadedAt.ToString("MMM dd, yyyy")</small>
                                    </div>
                                    <span class="btn btn-sm btn-outline-primary rounded-pill"><i class="fa-solid fa-eye me-1"></i> View File</span>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-0"><i class="fa-solid fa-triangle-exclamation me-2"></i> The customer did not upload any supporting documents for this claim.</div>
                    }
                </div>
            </div>
        </div>

        <!-- RIGHT SIDE: Surveyor Assignment Form -->
        <div class="col-lg-4">
            <div class="card shadow-lg border-0 rounded-3 sticky-top" style="top: 20px;">
                <div class="card-header text-white" style="background: linear-gradient(135deg, #0c387a, #1856b5);">
                    <h5 class="mb-0"><i class="fa-solid fa-user-check me-2"></i> Assign Surveyor</h5>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-info" style="font-size: 0.85rem;">
                        <i class="fa-solid fa-circle-info me-2"></i> After reviewing the details, select an available Surveyor Officer to physically inspect the vehicle and assess the damage.
                    </div>

                    <form asp-action="AssignSurveyor" method="post">
                        <!-- Hidden field to pass the ClaimId -->
                        <input type="hidden" name="claimId" value="@Model.ClaimId" />

                        <div class="mb-4">
                            <label class="form-label fw-bold">Select Surveyor Officer <span class="text-danger">*</span></label>
                            <select name="surveyorId" class="form-select border-primary" required>
                                <option value="">-- Choose an available Surveyor --</option>
                                @if (availableSurveyors != null)
                                {
                                    foreach (var surveyor in availableSurveyors)
                                    {
                                        <!-- Assuming your user model has 'Id' and 'Username' -->
                                        <option value="@surveyor.Email">@surveyor.Username</option>
                                    }
                                }
                            </select>
                        </div>

                        <button type="submit" class="btn btn-warning w-100 fw-bold shadow-sm btn-lg text-dark">
                            Assign & Transfer Claim <i class="fa-solid fa-paper-plane ms-2"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>