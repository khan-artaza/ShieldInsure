@model Final_Insure.DTOs.UserLoginDTO
@{
    ViewData["Title"] = "Staff Secure Login";
}

<div class="d-flex align-items-center justify-content-center py-5" style="min-height: 92vh; background: linear-gradient(135deg, #090d16 0%, #1e293b 100%); padding-top: 140px !important;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">

                <!-- Brand Header -->
                <div class="text-center mb-4">
                    <a class="navbar-brand fw-bold fs-3 text-white text-decoration-none d-inline-flex align-items-center" asp-controller="Home" asp-action="Index">
                        <div class="bg-primary bg-opacity-25 rounded-3 p-2 me-2 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                            <i class="fa-solid fa-shield-halved text-info fs-5"></i>
                        </div>
                        Shield<span style="color: #38bdf8;">Insure</span>
                    </a>
                    <p class="text-secondary small mt-2 font-monospace tracking-wide">SYS_ADMIN // INTERNAL OPERATIONS</p>
                </div>

                <!-- Glassmorphism Card -->
                <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5" style="background: rgba(255, 255, 255, 0.99); backdrop-filter: blur(20px);">
                    <div class="mb-4">
                        <h4 class="fw-bolder text-dark mb-1">Staff Authentication</h4>
                        <p class="text-muted small mb-0">Sign in with your secure employee credentials.</p>
                    </div>

                    <!-- Error State -->
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger border-0 rounded-3 py-2 px-3 small fw-semibold mb-4 d-flex align-items-center" style="background-color: #fef2f2; color: #dc2626;">
                            <i class="fa-solid fa-triangle-exclamation me-2 fs-5"></i>
                            <div>Invalid login attempt. Please check your credentials.</div>
                        </div>
                    }

                    <form asp-controller="Auth" asp-action="Login" method="post">
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-bold text-muted small text-uppercase tracking-wider">Staff Email / Username</label>
                            <div class="position-relative">
                                <i class="fa-solid fa-id-badge position-absolute text-muted" style="left: 18px; top: 50%; transform: translateY(-50%);"></i>
                                <input asp-for="Email" class="form-control form-control-lg bg-light border-0 shadow-none" style="padding-left: 48px; font-size: 0.95rem; border-radius: 10px;" placeholder="employee@shieldinsure.com" required />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Password" class="form-label fw-bold text-muted small text-uppercase tracking-wider">Secure Password</label>
                            <div class="position-relative">
                                <i class="fa-solid fa-lock position-absolute text-muted" style="left: 18px; top: 50%; transform: translateY(-50%);"></i>
                                <input asp-for="Password" type="password" class="form-control form-control-lg bg-light border-0 shadow-none" style="padding-left: 48px; font-size: 0.95rem; border-radius: 10px;" placeholder="••••••••" required />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <button type="submit" class="btn btn-lg w-100 fw-bold shadow-sm rounded-3 text-white transition-all py-3" style="background-color: #0f172a; letter-spacing: 0.3px;">
                            <i class="fa-solid fa-fingerprint me-2 text-info"></i> Authorize Access
                        </button>
                    </form>

                    <div class="text-center mt-4 border-top pt-4">
                        <p class="text-muted small mb-0">
                            New staff member? <a asp-controller="Auth" asp-action="RegisterStaff" class="text-decoration-none fw-bold" style="color: #0f172a;">Request Onboarding</a>
                        </p>
                    </div>
                </div>

                <div class="text-center mt-4 mb-4">
                    <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-secondary small fw-semibold">
                        <i class="fa-solid fa-arrow-left me-1"></i> Back to Homepage
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>