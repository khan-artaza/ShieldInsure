<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ShieldInsure</title>

    <!-- Modern Google Font: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- CSS Dependencies -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
            :root {
                --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
                --sidebar-bg: #090d16;
                --sidebar-border: rgba(255, 255, 255, 0.06);
                --primary-accent: #38bdf8;
            }

            body {
                font-family: var(--font-sans);
                background-color: #f8fafc;
                color: #1e293b;
                overflow-x: hidden;
            }

            /* Sleek Custom Scrollbars */
            ::-webkit-scrollbar {
                width: 6px;
                height: 6px;
            }

            ::-webkit-scrollbar-track {
                background: transparent;
            }

            ::-webkit-scrollbar-thumb {
                background: #cbd5e1;
                border-radius: 4px;
            }

                ::-webkit-scrollbar-thumb:hover {
                    background: #94a3b8;
                }

            /* Modern Dashboard Sidebar */
            #wrapper {
                display: flex;
                width: 100%;
                align-items: stretch;
            }

            #sidebar-wrapper {
                width: 280px;
                background: var(--sidebar-bg);
                border-right: 1px solid var(--sidebar-border);
                min-height: 100vh;
                transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
                z-index: 1020;
            }

            .sidebar-heading {
                font-size: 1.15rem;
                letter-spacing: -0.5px;
                background: linear-gradient(135deg, #fff 0%, #94a3b8 100%);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
            }

            .sidebar-link {
                display: flex;
                align-items: center;
                padding: 11px 16px;
                color: #94a3b8 !important;
                font-weight: 500;
                font-size: 0.92rem;
                border-radius: 8px;
                margin-bottom: 4px;
                transition: all 0.2s ease;
                text-decoration: none;
            }

                .sidebar-link:hover, .sidebar-link.active {
                    color: #fff !important;
                    background: rgba(255, 255, 255, 0.06);
                    transform: translateX(4px);
                }

                .sidebar-link i {
                    width: 24px;
                    font-size: 1rem;
                    margin-right: 12px;
                    color: #64748b;
                    transition: color 0.2s ease;
                }

                .sidebar-link:hover i, .sidebar-link.active i {
                    color: var(--primary-accent);
                }

            /* Dashboard Top Header Navbar */
            .dashboard-navbar {
                background: rgba(255, 255, 255, 0.85);
                backdrop-filter: blur(12px);
                -webkit-backdrop-filter: blur(12px);
                border-bottom: 1px solid #e2e8f0;
                position: sticky;
                top: 0;
                z-index: 1000;
            }

            /* Public Glassmorphism Navbar */
            .public-navbar {
                background: rgba(15, 23, 42, 0.85);
                backdrop-filter: blur(16px);
                -webkit-backdrop-filter: blur(16px);
                border-bottom: 1px solid rgba(255, 255, 255, 0.08);
                transition: all 0.3s ease;
            }

            .nav-link-glass {
                color: rgba(255, 255, 255, 0.75) !important;
                border-radius: 50rem;
                padding: 8px 16px !important;
                transition: all 0.2s ease;
            }

                .nav-link-glass:hover, .nav-link-glass.active {
                    color: #fff !important;
                    background: rgba(255, 255, 255, 0.08);
                }
    </style>
</head>
<body>

    @if (User.Identity.IsAuthenticated)
    {
        <!-- ==========================================
             AUTHENTICATED DASHBOARD LAYOUT
        =========================================== -->
        <div class="d-flex" id="wrapper">

            <!-- Sidebar Navigation -->
            <div class="d-flex flex-column p-3 text-white shadow-lg" id="sidebar-wrapper">
                <div class="sidebar-heading text-center py-3 fw-bold border-bottom border-secondary border-opacity-25 mb-4 d-flex align-items-center justify-content-center gap-2">
                    <div class="bg-primary bg-opacity-25 rounded-3 p-2 d-flex align-items-center justify-content-center shadow-sm" style="width: 38px; height: 38px;">
                        <i class="fa-solid fa-shield-halved text-info fs-5"></i>
                    </div>
                    <span>Shield<span style="color: #38bdf8;">Insure</span></span>
                </div>

                <div class="flex-grow-1 px-1">
                    <div class="text-uppercase text-muted fw-bold small mb-2 px-3" style="font-size: 0.7rem; letter-spacing: 0.08em;">Workspace</div>

                    <a asp-controller="Home" asp-action="Index" class="sidebar-link">
                        <i class="fa-solid fa-house"></i> My Dashboard
                    </a>
                    <a asp-controller="Auth" asp-action="Profile" class="sidebar-link">
                        <i class="fa-solid fa-user-gear"></i> Account Profile
                    </a>
                </div>

                <div class="mt-auto pt-3 border-top border-secondary border-opacity-25 px-1">
                    <form asp-controller="Auth" asp-action="Logout" method="post" class="w-100">
                        <button type="submit" class="btn btn-outline-danger w-100 fw-bold shadow-sm rounded-3 py-2 d-flex align-items-center justify-content-center gap-2 border-opacity-50 transition-all">
                            <i class="fa-solid fa-right-from-bracket"></i> Sign Out
                        </button>
                    </form>
                </div>
            </div>

            <!-- Page Content Wrapper -->
            <div id="page-content-wrapper" class="w-100 d-flex flex-column min-vh-100">

                <!-- Professional Top Navbar -->
                <nav class="navbar navbar-expand-lg dashboard-navbar py-3 px-4">
                    <div class="container-fluid px-0">
                        <div class="d-flex align-items-center gap-3">
                            <button class="btn btn-link text-dark p-0 border-0 shadow-none" id="menu-toggle" type="button" aria-label="Toggle Navigation">
                                <i class="fa-solid fa-bars fs-5"></i>
                            </button>
                            <h5 class="mb-0 fw-bold text-dark" style="letter-spacing: -0.3px;">@ViewData["Title"]</h5>
                        </div>

                        <div class="ms-auto d-flex align-items-center gap-3">
                            <div class="d-flex align-items-center gap-2 bg-light px-3 py-1.5 rounded-pill border shadow-sm">
                                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 32px; height: 32px; font-size: 0.85rem;">
                                    @User.Identity.Name.Substring(0, 1).ToUpper()
                                </div>
                                <span class="text-dark fw-semibold small pe-1">@User.Identity.Name</span>
                            </div>
                        </div>
                    </div>
                </nav>

                <!-- Dynamic Page Content -->
                <main class="flex-grow-1 p-4">
                    @RenderBody()
                </main>

                <!-- Enterprise Footer -->
                <footer class="bg-white border-top py-3 px-4 text-center text-muted small">
                    &copy; @DateTime.Now.Year ShieldInsure. Secure Enterprise Operations Platform.
                </footer>
            </div>
        </div>
    }
    else
    {
        <!-- ==========================================
             PUBLIC / GUEST LAYOUT (GLASSMORPHISM)
        =========================================== -->
        <nav class="navbar navbar-expand-lg navbar-dark public-navbar fixed-top py-3">
            <div class="container">
                <a class="navbar-brand fw-bold fs-4 m-0 d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <div class="bg-primary bg-opacity-25 rounded-3 p-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                        <i class="fa-solid fa-shield-halved text-info fs-5"></i>
                    </div>
                    <span>Shield<span style="color: #38bdf8;">Insure</span></span>
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#publicNavbar" aria-controls="publicNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse justify-content-center" id="publicNavbar">
                    <ul class="navbar-nav fw-medium gap-1">
                        <li class="nav-item"><a class="nav-link nav-link-glass" href="#home">Home</a></li>
                        <li class="nav-item"><a class="nav-link nav-link-glass" href="#features">Why Us</a></li>
                        <li class="nav-item"><a class="nav-link nav-link-glass" href="#how-it-works">Process</a></li>
                        <li class="nav-item"><a class="nav-link nav-link-glass" href="#faq">FAQ</a></li>
                        <li class="nav-item"><a class="nav-link nav-link-glass" href="#contact">Contact</a></li>
                    </ul>
                </div>

                <div class="d-none d-lg-flex">
                    <a href="/Auth/Login" class="btn btn-outline-info fw-bold rounded-pill px-4 btn-sm py-2 shadow-sm" style="border-width: 2px;">
                        Sign In <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </nav>

        <main role="main">
            @RenderBody()
        </main>

        <footer class="bg-dark text-light py-5 border-top border-secondary border-opacity-25">
            <div class="container text-center">
                <h4 class="fw-bold mb-3"><i class="fa-solid fa-shield-halved text-info me-2"></i>ShieldInsure</h4>
                <p class="text-muted mb-0 small">&copy; @DateTime.Now.Year ShieldInsure. All rights reserved.</p>
            </div>
        </footer>
    }

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
            // Toggle Sidebar Script
            $("#menu-toggle").click(function(e) {
                e.preventDefault();
                $("#wrapper").toggleClass("toggled");
            });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>