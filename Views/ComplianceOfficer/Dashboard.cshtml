@model IEnumerable<Final_Insure.Models.Claim>
@{
    ViewData["Title"] = "Compliance Dashboard";
}

<div class="container-fluid py-2">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bolder text-dark mb-1">Compliance & Fraud Dept</h3>
            <p class="text-muted mb-0">Review surveyor reports and execute background fraud checks.</p>
        </div>
    </div>

    <!-- Success Message Alert -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-3 mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- FRAUD CHECK TABLE -->
    <!-- Swapped red for a professional deep indigo border -->
    <div class="card border-0 shadow-sm mb-4" style="border-top: 3px solid #4f46e5 !important;">
        <div class="card-header bg-white border-bottom py-3">
            <h6 class="mb-0 fw-bold" style="color: #4f46e5;"><i class="fa-solid fa-shield-halved me-2"></i> Claims Pending Background Check</h6>
        </div>
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-muted">
                            <tr>
                                <th class="ps-4">Claim ID</th>
                                <th>Incident Date</th>
                                <th>Requested Amount</th>
                                <th>Status</th>
                                <th class="text-end pe-4">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var claim in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-dark">#CLM-@claim.ClaimId.ToString("D4")</td>
                                    <td>@claim.IncidentDate.ToString("MMM dd, yyyy")</td>
                                    <td class="fw-semibold text-dark">$@claim.ClaimAmount.ToString("N0")</td>
                                    <td>
                                        <!-- Custom Indigo Pill Badge -->
                                        <span class="badge rounded-pill px-3" style="background-color: rgba(79, 70, 229, 0.1); color: #4f46e5; border: 1px solid rgba(79, 70, 229, 0.3);">
                                            @claim.ClaimStatus
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <!-- Swapped to a clean dark button -->
                                        <a asp-action="SubmitFraudCheck" asp-route-claimId="@claim.ClaimId" class="btn btn-sm btn-dark fw-semibold shadow-sm">
                                            Run Fraud Check <i class="fa-solid fa-user-shield ms-1"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-5 text-center text-muted">
                    <i class="fa-solid fa-clipboard-check fs-1 mb-3 text-secondary opacity-50 d-block"></i>
                    <h6 class="fw-semibold text-dark">All Clear!</h6>
                    <p class="small mb-0">There are no claims currently waiting for a fraud check.</p>
                </div>
            }
        </div>
    </div>
</div>