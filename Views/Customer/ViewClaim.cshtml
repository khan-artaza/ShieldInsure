@model Final_Insure.Models.Claim
@{
    ViewData["Title"] = "Claim Details";
}

<div class="row g-4">
    <!-- Claim Details -->
    <div class="col-md-7">
        <div class="card card-shadow-md h-100 overflow-hidden">
            <div class="card-header bg-dark text-white" style="border-bottom:none!important;">
                <h5 class="mb-0 fw-700 text-white">
                    <i class="fa-solid fa-file-lines me-2 "></i>
                    Claim Record: #CLM-@Model.ClaimId.ToString("D4")
                </h5>
            </div>
            <div class="card-body p-4">
                <h6 class="fw-700 mb-3 text-muted" style="font-size:.8rem; text-transform:uppercase; letter-spacing:.06em;">Incident Overview</h6>
                <div class="detail-row">
                    <span class="detail-label">Date</span>
                    <span class="detail-value">@Model.IncidentDate.ToString("MMM dd, yyyy")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Location</span>
                    <span class="detail-value text-muted">@Model.AccidentAddress</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Type</span>
                    <span class="detail-value fw-600">@Model.ClaimType</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Requested Payout</span>
                    <span class="detail-value fw-bold text-success">$@Model.ClaimAmount.ToString("N0")</span>
                </div>

                <hr class="my-3 opacity-25">
                <h6 class="fw-700 mb-2">Description</h6>
                <p class="text-muted p-3 rounded-3 border mb-0" style="font-size:.875rem; background:#f8fafc;">@Model.Description</p>

                <div class="mt-4">
                    <a asp-action="Dashboard" class="btn btn-outline-secondary fw-600">
                        <i class="fa-solid fa-arrow-left me-2"></i> Back to Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Uploaded Evidence -->
    <div class="col-md-5">
        <div class="card card-shadow-md h-100 overflow-hidden">
            <div class="card-header bg-secondary text-white" style="border-bottom:none!important;">
                <h5 class="mb-0 fw-700 text-white">
                    <i class="bi bi-paperclip me-2"></i> Uploaded Evidence
                </h5>
            </div>
            <div class="card-body p-4">
                @if (Model.ClaimDocuments != null && Model.ClaimDocuments.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var doc in Model.ClaimDocuments)
                        {
                            <a href="@doc.FilePath" target="_blank"
                               class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                <div>
                                    <strong style="font-size:.875rem;">@doc.DocumentName</strong><br />
                                    <small class="text-muted">Uploaded: @doc.UploadedAt.ToString("MMM dd")</small>
                                </div>
                                <span class="badge badge-soft-primary rounded-pill px-3">
                                    <i class="bi bi-eye me-1"></i> View
                                </span>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state" style="padding:2rem 1rem;">
                        <i class="bi bi-file-earmark-x empty-state-icon"></i>
                        <p class="empty-state-title">No Documents</p>
                        <p class="empty-state-text">No documents were uploaded with this claim.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
