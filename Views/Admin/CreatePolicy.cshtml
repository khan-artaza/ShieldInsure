@model Final_Insure.Models.Policy
@{
    ViewData["Title"] = "Create New Policy";
}

<div class="d-flex justify-content-center">
    <!-- STRICT COMPACT CONTAINER -->
    <div style="width: 100%; max-width: 600px; margin: 0 auto;">
        <div class="card border-0 shadow-sm" style="border-radius: 10px; overflow: hidden; background: #fff;">

            <!-- Scaled down header -->
            <div class="text-white d-flex align-items-center" style="background: linear-gradient(135deg, #0c387a, #1856b5); padding: 15px 16px;">
                <h6 class="mb-0 fw-bold text-white" style="font-size: .85rem; letter-spacing: 0.2px;">
                    <i class="fa-solid fa-cloud-arrow-up me-2"></i> Publish a New Insurance Policy
                </h6>
            </div>

            <!-- Tighter padding inside the card -->
            <div class="card-body" style="padding: 16px 20px;">
                <form asp-action="CreatePolicy" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Status" value="Active" />

                    <!-- Using gx-2 to reduce horizontal gap between columns -->
                    <div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px;row-gap:20px; width: 100%;">

                        <div>
                            <label asp-for="PolicyNumber" class="form-label" style="font-size:.65rem; margin-bottom:2px; font-weight:700; color:#475569;">Policy Number <span class="text-danger">*</span></label>
                            <input asp-for="PolicyNumber" class="form-control shadow-none" placeholder="e.g., POL-AUTO-01" required style="font-size:.75rem; padding: 4px 8px; min-height: 28px; border-radius: 6px; width:100%; box-sizing:border-box;" />
                            <span asp-validation-for="PolicyNumber" class="text-danger" style="font-size:.65rem;"></span>
                        </div>

                        <div>
                            <label asp-for="PolicyType" class="form-label" style="font-size:.65rem; margin-bottom:2px; font-weight:700; color:#475569;">Policy Type <span class="text-danger">*</span></label>
                            <select asp-for="PolicyType" class="form-select shadow-none" required style="font-size:.75rem; padding: 4px 8px; min-height: 28px; border-radius: 6px; width:100%; box-sizing:border-box;">
                                <option value="">— Select Type —</option>
                                <option value="Auto Comprehensive Policy">Auto Comprehensive Policy</option>
                                <option value="Third-Party Only Policy ">Third-Party Only Policy </option>
                            </select>
                            <span asp-validation-for="PolicyType" class="text-danger" style="font-size:.65rem;"></span>
                        </div>

                        <div>
                            <label asp-for="CoverageAmount" class="form-label" style="font-size:.65rem; margin-bottom:2px; font-weight:700; color:#475569;">Coverage ($) <span class="text-danger">*</span></label>
                            <input asp-for="CoverageAmount" type="number" step="0.01" class="form-control shadow-none" placeholder="50000.00" required style="font-size:.75rem; padding: 4px 8px; min-height: 28px; border-radius: 6px; width:100%; box-sizing:border-box;" />
                            <span asp-validation-for="CoverageAmount" class="text-danger" style="font-size:.65rem;"></span>
                        </div>

                        <div>
                            <label asp-for="PremiumAmount" class="form-label" style="font-size:.65rem; margin-bottom:2px; font-weight:700; color:#475569;">Monthly Premium ($) <span class="text-danger">*</span></label>
                            <input asp-for="PremiumAmount" type="number" step="0.01" class="form-control shadow-none" placeholder="150.00" required style="font-size:.75rem; padding: 4px 8px; min-height: 28px; border-radius: 6px; width:100%; box-sizing:border-box;" />
                            <span asp-validation-for="PremiumAmount" class="text-danger" style="font-size:.65rem;"></span>
                        </div>

                        <div>
                            <label asp-for="StartDate" class="form-label" style="font-size:.65rem; margin-bottom:2px; font-weight:700; color:#475569;">Start Date <span class="text-danger">*</span></label>
                            <input asp-for="StartDate" type="date" class="form-control shadow-none" required style="font-size:.75rem; padding: 4px 8px; min-height: 28px; border-radius: 6px; width:100%; box-sizing:border-box;" />
                            <span asp-validation-for="StartDate" class="text-danger" style="font-size:.65rem;"></span>
                        </div>

                        <div>
                            <label asp-for="EndDate" class="form-label" style="font-size:.65rem; margin-bottom:2px; font-weight:700; color:#475569;">End Date <span class="text-danger">*</span></label>
                            <input asp-for="EndDate" type="date" class="form-control shadow-none" required style="font-size:.75rem; padding: 4px 8px; min-height: 28px; border-radius: 6px; width:100%; box-sizing:border-box;" />
                            <span asp-validation-for="EndDate" class="text-danger" style="font-size:.65rem;"></span>
                        </div>

                    </div>

                

                    <!-- Compact footer buttons -->
                    <div class="d-flex justify-content-between align-items-center pt-2 mt-1 border-top">
                        <a asp-action="Dashboard" class="btn shadow-none" style="font-size:.75rem; padding: 12px 14px; border-radius: 6px; background:#e2e8f0; color:#475569; font-weight:600; text-decoration:none;">Cancel</a>
                        <button type="submit" class="btn text-white shadow-none" style="font-size:.75rem; padding: 12px 18px; border-radius: 6px; background:#10b981; font-weight:600; border:none;">
                            <i class="fa-solid fa-cloud-arrow-up me-1"></i> Publish Policy
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>