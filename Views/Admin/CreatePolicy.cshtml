@model Final_Insure.Models.Policy

@{
    ViewData["Title"] = "Create New Policy";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header text-white" style="background: linear-gradient(135deg, #0c387a, #1856b5);">
                    <h5 class="mb-0">Publish a New Insurance Policy</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="CreatePolicy" method="post">

                        <!-- System Default for Master Policy -->
                        <!-- Note: Since CustomerId is [Required], we pass a default value of 0 for master template policies -->
                        
                        <input type="hidden" asp-for="Status" value="Active" />

                        <div class="row">
                            <!-- Policy Number -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="PolicyNumber" class="form-label fw-bold">Policy Number</label>
                                <input asp-for="PolicyNumber" class="form-control" placeholder="e.g., POL-2026-AUTO-01" required />
                                <span asp-validation-for="PolicyNumber" class="text-danger"></span>
                            </div>

                            <!-- Policy Type -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="PolicyType" class="form-label fw-bold">Policy Type</label>
                                <select asp-for="PolicyType" class="form-select" required>
                                    <option value="">-- Select Type --</option>
                                    <option value="Auto">Auto Insurance</option>
                                    <option value="Health">Health Insurance</option>
                                    <option value="Property">Property Insurance</option>
                                    <option value="Life">Life Insurance</option>
                                </select>
                                <span asp-validation-for="PolicyType" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <!-- Coverage Amount -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="CoverageAmount" class="form-label fw-bold">Coverage Amount ($)</label>
                                <input asp-for="CoverageAmount" type="number" step="0.01" class="form-control" placeholder="50000.00" required />
                                <span asp-validation-for="CoverageAmount" class="text-danger"></span>
                            </div>

                            <!-- Premium Amount -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="PremiumAmount" class="form-label fw-bold">Monthly Premium ($)</label>
                                <input asp-for="PremiumAmount" type="number" step="0.01" class="form-control" placeholder="150.00" required />
                                <span asp-validation-for="PremiumAmount" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <!-- Start Date -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="StartDate" class="form-label fw-bold">Availability Start Date</label>
                                <input asp-for="StartDate" type="date" class="form-control" required />
                                <span asp-validation-for="StartDate" class="text-danger"></span>
                            </div>

                            <!-- End Date -->
                            <div class="col-md-6 mb-4">
                                <label asp-for="EndDate" class="form-label fw-bold">Availability End Date</label>
                                <input asp-for="EndDate" type="date" class="form-control" required />
                                <span asp-validation-for="EndDate" class="text-danger"></span>
                            </div>
                        </div>

                        <hr class="mb-4" />
                        <h6 class="fw-bold text-muted mb-3">Vehicle Specific Details (Optional)</h6>

                        <div class="row">
                            <!-- Vehicle RC -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="VehicleRC" class="form-label fw-bold">Vehicle RC (If Auto)</label>
                                <input asp-for="VehicleRC" class="form-control" placeholder="Leave blank if not auto policy" />
                                <span asp-validation-for="VehicleRC" class="text-danger"></span>
                            </div>

                            <!-- Chassis Number -->
                            <div class="col-md-6 mb-4">
                                <label asp-for="ChassisNumber" class="form-label fw-bold">Chassis Number</label>
                                <input asp-for="ChassisNumber" class="form-control" placeholder="Leave blank if not auto policy" />
                                <span asp-validation-for="ChassisNumber" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-2">
                            <a asp-action="Dashboard" class="btn btn-outline-secondary px-4">Cancel</a>
                            <button type="submit" class="btn btn-success fw-bold px-5 shadow-sm">Publish Policy</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>