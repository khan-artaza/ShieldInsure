@model IEnumerable<Final_Insure.Models.Policy>
@{
    ViewData["Title"] = "Insurance Catalog";
}

<style>
    .plan-card { transition: transform .25s ease, box-shadow .25s ease; }
    .plan-card:hover { transform: translateY(-6px); box-shadow: 0 20px 50px rgba(12,56,122,.12) !important; }
    .plan-header { background: linear-gradient(135deg, #0c387a, #1a56c4); padding: 1.75rem; text-align: center; }
</style>

<div class="page-header">
    <div>
        <span class="badge badge-soft-primary rounded-pill px-3 mb-1 fw-bold" style="font-size:.72rem;">POLICY CATALOG</span>
        <h1 class="page-header-title">Available Insurance Plans</h1>
        <p class="page-header-subtitle">Browse our latest insurance offerings and protect what matters most.</p>
    </div>
</div>

<div class="row g-4">
    @if (Model != null && Model.Any())
    {
        foreach (var plan in Model)
        {
            <div class="col-md-4">
                <div class="card plan-card h-100 overflow-hidden">
                    <div class="plan-header">
                        <h4 class="fw-bold text-white mb-1">@plan.PolicyType Insurance</h4>
                        <span class="badge bg-white bg-opacity-20 text-white font-mono" style="font-size:.75rem;">@plan.PolicyNumber</span>
                    </div>
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="text-center my-3">
                            <h2 class="fw-800 text-success mb-1">$@plan.PremiumAmount.ToString("0.00")</h2>
                            <span class="text-muted fw-600" style="font-size:.75rem; text-transform:uppercase; letter-spacing:.06em;">Monthly Premium</span>
                        </div>
                        <hr class="my-3 opacity-25">
                        <ul class="list-unstyled mb-4" style="font-size:.875rem;">
                            <li class="d-flex align-items-center gap-2 mb-3">
                                <i class="bi bi-check-circle-fill text-success fs-5 flex-shrink-0"></i>
                                <span><strong>Coverage Limit:</strong> $@plan.CoverageAmount.ToString("N0")</span>
                            </li>
                            <li class="d-flex align-items-center gap-2 mb-3">
                                <i class="bi bi-check-circle-fill text-success fs-5 flex-shrink-0"></i>
                                <span><strong>Plan Status:</strong> Active &amp; Ready</span>
                            </li>
                            <li class="d-flex align-items-center gap-2">
                                <i class="bi bi-check-circle-fill text-success fs-5 flex-shrink-0"></i>
                                <span>Instant Digital Approval &amp; Policy Document</span>
                            </li>
                        </ul>
                        <div class="mt-auto">
                            <a asp-action="Checkout" asp-route-planId="@plan.PolicyId"
                               class="btn btn-brand w-100 py-3 fw-bold">
                                Buy Now <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="empty-state card py-5">
                <i class="bi bi-inbox empty-state-icon"></i>
                <p class="empty-state-title">No Policies Available</p>
                <p class="empty-state-text">Please check back later or contact support assistance.</p>
            </div>
        </div>
    }
</div>
