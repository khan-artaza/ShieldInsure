@model Final_Insure.DTOs.SubmitFraudCheckDTO
@using Final_Insure.Models
@{
    ViewData["Title"] = "Submit Fraud Check";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var claim = ViewBag.ClaimData as Claim;
    var assessment = ViewBag.AssessmentData as Assessment;
    string barColor = "bg-success";
    if (Model.FraudScore >= 80) barColor = "bg-danger";
    else if (Model.FraudScore >= 50) barColor = "bg-warning";
}

<div class="page-header mb-3">
    <div class="d-flex justify-content-between align-items-center w-100">
        <div>
            <h3 class="page-header-title text-danger mb-1">Fraud Investigation Report</h3>
            <p class="page-header-subtitle mb-0" style="font-size:0.9rem;">Review case file data and submit final verdict for Claim #@Model.ClaimId.</p>
        </div>
        <a asp-action="Dashboard" class="btn btn-sm btn-outline-secondary fw-bold">
            <i class="fa-solid fa-arrow-left me-1"></i> Cancel &amp; Back
        </a>
    </div>
</div>

<div class="row g-3">
    <!-- Reduced gap from g-4 to g-3 -->
    <!-- Left: Case File -->
    <div class="col-lg-5">
        <div class="card card-shadow-md overflow-hidden h-100 shadow-sm">
            <!-- Slimmer Header -->
            <div class="card-header bg-dark text-white py-3" style="border-bottom:none!important;">
                <h6 class="mb-0 fw-bold text-white">
                    <i class="fa-solid fa-folder-open me-1"></i> Case File Data
                </h6>
            </div>
            <!-- Reduced padding from p-4 to p-3 -->
            <div class="card-body p-3" style="background:#f8fafc;">

                @if (claim != null)
                {
                    <p class="text-muted fw-bold mb-2" style="font-size:.7rem; text-transform:uppercase; letter-spacing:.05em;">1. Policy Details</p>
                    <div class="detail-row d-flex justify-content-between mb-1">
                        <span class="text-muted" style="font-size: 0.85rem;">Policy Status</span>
                        <span class="badge @(claim.Policy?.Status == PolicyStatus.Active ? "badge-soft-success" : "badge-soft-danger") rounded-pill px-2" style="font-size: 0.75rem;">
                            @claim.Policy?.Status
                        </span>
                    </div>
                    <div class="detail-row d-flex justify-content-between mb-1">
                        <span class="text-muted" style="font-size: 0.85rem;">Days Since Purchase</span>
                        <span class="fw-semibold" style="font-size: 0.85rem;">
                            @(claim.Policy != null ? Math.Round((claim.IncidentDate - claim.Policy.StartDate).TotalDays) : "Unknown") days
                        </span>
                    </div>
                    <hr class="opacity-25 my-2"> <!-- my-3 to my-2 -->
                }

                @if (assessment != null)
                {
                    <p class="text-muted fw-bold mb-2" style="font-size:.7rem; text-transform:uppercase; letter-spacing:.05em;">2. Surveyor Field Report</p>
                    <!-- Compacted Alert Box -->
                    <div class="p-2 mb-2 rounded-3 border @(assessment.AccidentMatchesDescription ? "" : "border-danger")"
                         style="background:@(assessment.AccidentMatchesDescription ? "#f0fdf4" : "#fef2f2");">
                        <strong style="font-size:.8rem;">Damage Matches Story?</strong><br />
                        @if (assessment.AccidentMatchesDescription)
                        {
                            <span class="text-success fw-bold" style="font-size:.8rem;">
                                <i class="fa-solid fa-check-circle me-1"></i> Yes, matches customer description.
                            </span>
                        }
                        else
                        {
                            <span class="text-danger fw-bold" style="font-size:.8rem;">
                                <i class="fa-solid fa-triangle-exclamation me-1"></i> NO. Flagged as highly suspicious!
                            </span>
                        }
                    </div>
                    <div class="detail-row d-flex justify-content-between mb-1">
                        <span class="text-muted" style="font-size: 0.85rem;">Assessed Cost</span>
                        <span class="fw-semibold" style="font-size: 0.85rem;">$@assessment.AssessedAmount.ToString("N0")</span>
                    </div>
                    <div class="detail-row d-flex flex-column mb-1">
                        <span class="text-muted mb-1" style="font-size: 0.85rem;">Surveyor Notes</span>
                        <span class="text-dark bg-white border p-2 rounded" style="font-size:.8rem;">@(assessment.AssessmentRemarks ?? "None")</span>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning py-2 mb-0" style="font-size: 0.85rem;">
                        <i class="fa-solid fa-circle-info me-1"></i> Surveyor report missing.
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Right: Audit Form -->
    <div class="col-lg-7">
        <div class="card card-shadow-lg overflow-hidden shadow-sm">
            <!-- Slimmer Header -->
            <div class="card-header bg-danger text-white py-3" style="border-bottom:none!important;">
                <h6 class="mb-0 fw-bold text-white">
                    <i class="fa-solid fa-gavel me-1"></i> Official Verdict
                </h6>
            </div>
            <!-- Reduced padding from p-4 to p-3 -->
            <div class="card-body p-3">

                <!-- Compacted Fraud Score Visualizer -->
                <div class="p-3 border rounded-3 mb-3" style="background:rgba(239,68,68,.04);">
                    <div class="d-flex justify-content-between align-items-end mb-2">
                        <span class="fw-bold text-dark" style="font-size: 0.9rem;">System Fraud Score</span>
                        <h4 class="mb-0 fw-bold @(Model.FraudScore >= 80 ? "text-danger" : "text-dark")">
                            @Model.FraudScore<span class="text-muted fw-normal" style="font-size:0.85rem;">/100</span>
                        </h4>
                    </div>
                    <div class="progress" style="height:8px; border-radius:4px;">
                        <div class="progress-bar progress-bar-striped progress-bar-animated @barColor"
                             role="progressbar"
                             style="width:@Model.FraudScore%;"
                             aria-valuenow="@Model.FraudScore" aria-valuemin="0" aria-valuemax="100">
                        </div>
                    </div>
                </div>

                <form asp-action="SubmitFraudCheck" method="post">
                    <input type="hidden" asp-for="ClaimId" />

                    <!-- Tightened inputs margin -->
                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label asp-for="FraudScore" class="form-label mb-1" style="font-size: 0.85rem;">Calculated Risk Score</label>
                            <div class="input-group input-group-sm">
                                <input asp-for="FraudScore" type="number" class="form-control fw-bold bg-light" readonly />
                                <span class="input-group-text">/&nbsp;100</span>
                            </div>
                            <span asp-validation-for="FraudScore" class="text-danger d-block mt-1" style="font-size:.75rem;"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="RiskFlag" class="form-label mb-1" style="font-size: 0.85rem;">Risk Level <span class="text-danger">*</span></label>
                            <select asp-for="RiskFlag" class="form-select form-select-sm fw-bold"
                                    asp-items="Html.GetEnumSelectList<RiskFlag>()"
                                    style="border-color:#ef4444!important;">
                                <option value="">— Select Risk Level —</option>
                            </select>
                            <span asp-validation-for="RiskFlag" class="text-danger d-block mt-1" style="font-size:.75rem;"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <!-- Margin mb-4 to mb-3 -->
                        <label asp-for="InvestigatorRemarks" class="form-label mb-1" style="font-size: 0.85rem;">Investigator Remarks <span class="text-danger">*</span></label>
                        <!-- Reduced rows from 4 to 2 -->
                        <textarea asp-for="InvestigatorRemarks" class="form-control form-control-sm" rows="2"
                                  placeholder="Detail the background check findings..." required></textarea>
                        <span asp-validation-for="InvestigatorRemarks" class="text-danger d-block mt-1" style="font-size:.75rem;"></span>
                    </div>

                    <div class="alert alert-warning py-2 mb-3">
                        <!-- Reduced padding/margin -->
                        <i class="fa-solid fa-triangle-exclamation me-1 text-danger" style="font-size:0.8rem;"></i>
                        <span class="text-danger fw-bold" style="font-size:.75rem;">
                            High/Critical flag or score 80+ auto-rejects claim.
                        </span>
                    </div>

                    <!-- Reduced button padding (removed py-3) -->
                    <div style="width:100%; display:flex; justify-content:center; align-items:center; ">
                        <button type="submit" class="btn btn-danger w-20 fw-bold align-content-center" style="padding:12px; margin:auto;">
                            Submit Final Verdict <i class="fa-solid fa-file-signature ms-1"></i>
                        </button>
                    </div>
                    
                </form>
            </div>
        </div>
    </div>
</div>