@{
    ViewData["HideNavbar"] = true;
}
@model Final_Insure.DTOs.RegisterStaffDTO
@using Final_Insure.Models
@{
    ViewData["Title"] = "Staff Onboarding";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Removed 'auth-page' class to prevent site.css from adding unwanted padding. Using pure inline layout. -->
<div style="background: linear-gradient(140deg, #050b18 0%, #0c1a30 55%, #071222 100%); width: 100%; height: 100vh; overflow: hidden; display: flex; align-items: center; justify-content: center; position: fixed; top: 0; left: 0; z-index: 9999; margin: 0; padding: 10px;">

    <!-- STRICT COMPACT CONTAINER -->
    <div style="width: 100%; max-width: 340px;">

        <!-- Scaled down header -->
        <div class="text-center mb-2">
            <a asp-controller="Home" asp-action="Index" class="d-inline-flex align-items-center gap-2 text-decoration-none">
                <div style="width: 28px; height: 28px; background: linear-gradient(135deg, #1d4ed8, #38bdf8); border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                    <i class="fa-solid fa-shield-halved text-white" style="font-size: .8rem;"></i>
                </div>
                <span class="fw-800 text-white" style="font-size: 1.05rem;">Shield<span style="color:#38bdf8;">Insure</span></span>
            </a>
            <p class="mt-1 mb-0" style="color:rgba(255,255,255,.45); font-size:.6rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase;">Employee Identity</p>
        </div>

        <!-- Removed 'auth-card' class. Using standard bg-white to bypass your CSS padding rules -->
        <div class="bg-white shadow-lg" style="border-radius: 12px; padding: 16px 18px;">

            <div class="text-center mb-2">
                <h4 class="fw-800 mb-0" style="letter-spacing:-.4px; font-size: .95rem;">Register Staff</h4>
                <p class="text-muted mb-0" style="font-size:.65rem;">Setup role & credentials</p>
            </div>

            <!-- Shrunk alert box -->
            <div class="alert alert-warning d-flex align-items-center gap-2 mb-2" style="padding: 5px 10px; font-size: .65rem; border-radius: 6px; margin-bottom: 12px;">
                <i class="fa-solid fa-user-lock"></i>
                <span style="font-weight:600; line-height: 1.1;">Admin approval required.</span>
            </div>

            <form asp-controller="Auth" asp-action="RegisterStaff" method="post">
                <div class="mb-2">
                    <label asp-for="Role" class="form-label" style="font-size:.65rem; margin-bottom:2px;">Department Role *</label>
                    <select asp-for="Role" class="form-select shadow-none" asp-items="@(ViewBag.Roles as SelectList)" required style="font-size:.7rem; padding: 4px 8px; min-height: 28px; border-radius: 6px;">
                        <option value="">-- Select --</option>
                    </select>
                </div>

                <!-- Replaced 'form-control-icon' with pure bootstrap positioning -->
                <div class="mb-2">
                    <label asp-for="Username" class="form-label" style="font-size:.65rem; margin-bottom:2px;">Full Name *</label>
                    <div class="position-relative">
                        <i class="fa-solid fa-user position-absolute text-muted" style="font-size:.7rem; top: 50%; transform: translateY(-50%); left: 10px;"></i>
                        <input asp-for="Username" class="form-control shadow-none" placeholder="Rajesh Kumar" required style="font-size:.75rem; padding: 4px 10px 4px 28px; min-height: 30px; border-radius: 6px;" />
                    </div>
                </div>

                <div class="mb-2">
                    <label asp-for="Email" class="form-label" style="font-size:.65rem; margin-bottom:2px;">Official Email *</label>
                    <div class="position-relative">
                        <i class="fa-solid fa-envelope position-absolute text-muted" style="font-size:.7rem; top: 50%; transform: translateY(-50%); left: 10px;"></i>
                        <input asp-for="Email" type="email" class="form-control shadow-none" placeholder="staff@shieldinsure.com" required style="font-size:.75rem; padding: 4px 10px 4px 28px; min-height: 30px; border-radius: 6px;" />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label" style="font-size:.65rem; margin-bottom:2px;">Password *</label>
                    <div class="position-relative">
                        <i class="fa-solid fa-key position-absolute text-muted" style="font-size:.7rem; top: 50%; transform: translateY(-50%); left: 10px;"></i>
                        <input asp-for="Password" type="password" class="form-control shadow-none" placeholder="••••••••" required style="font-size:.75rem; padding: 4px 10px 4px 28px; min-height: 30px; border-radius: 6px;" />
                    </div>
                </div>

                <!-- Button text scaled down, padding reduced -->
                <button type="submit" class="btn w-100 fw-bold border-0 text-white d-flex justify-content-center align-items-center shadow-none" style="background:#0f172a; padding:6px; font-size:.75rem; border-radius: 6px;">
                    <i class="fa-solid fa-user-plus me-2 text-info"></i> Submit Request
                </button>
            </form>

            <div class="text-center mt-2 pt-2" style="border-top:1px solid #e2e8f0;">
                <p class="text-muted mb-0" style="font-size:.7rem;">
                    Already registered? <a asp-controller="Auth" asp-action="StaffLogin" class="fw-bold text-decoration-none" style="color:#0f172a;">Sign In</a>
                </p>
            </div>
        </div>

        <div class="text-center mt-2">
            <a asp-controller="Home" asp-action="Index" style="color:rgba(255,255,255,.4); font-size:.65rem; font-weight:600; text-decoration:none;">
                <i class="fa-solid fa-arrow-left me-1"></i> Back Home
            </a>
        </div>

    </div>
</div>