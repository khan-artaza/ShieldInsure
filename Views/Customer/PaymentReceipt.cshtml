@model Final_Insure.Models.Claim
@{
    ViewData["Title"] = "My Settlement Receipt";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-md-9">
        <div class="card card-shadow-lg overflow-hidden">

            <div class="receipt-header">
                <i class="fa-solid fa-circle-check" style="font-size:3rem; opacity:.9;"></i>
                <h3 class="mt-3 fw-800 mb-1">Claim Settled Successfully</h3>
                <p class="mb-0 text-white opacity-75" style="font-size:.9rem;">Official Transaction Receipt</p>
            </div>

            <div class="card-body p-4 p-md-5">

                <div class="row mb-4">
                    <div class="col-6">
                        <p class="text-muted mb-1" style="font-size:.72rem; font-weight:700; text-transform:uppercase; letter-spacing:.06em;">Claim Reference ID</p>
                        <h5 class="fw-800">#CLM-@Model.ClaimId.ToString("D4")</h5>
                    </div>
                    <div class="col-6 text-end">
                        <p class="text-muted mb-1" style="font-size:.72rem; font-weight:700; text-transform:uppercase; letter-spacing:.06em;">Settlement Date</p>
                        <h5 class="fw-800">@(Model.IncidentDate.ToString("MMM dd, yyyy"))</h5>
                    </div>
                </div>

                <hr class="my-4 opacity-25">

                <div class="detail-row">
                    <span class="detail-label">Original Requested Amount</span>
                    <span class="detail-value fw-bold">$@Model.ClaimAmount.ToString("N0")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Claim Type</span>
                    <span class="detail-value fw-600">@Model.ClaimType</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Final Status</span>
                    <span class="detail-value">
                        <span class="badge badge-soft-success rounded-pill px-3 py-2">@Model.ClaimStatus</span>
                    </span>
                </div>

                <div class="receipt-total-box mt-4 d-flex justify-content-between align-items-center">
                    <span class="fw-700 text-muted">Total Approved Payout</span>
                    <h2 class="mb-0 fw-800 text-success">$@Model.ClaimAmount.ToString("N0")</h2>
                </div>

                <div class="text-center mt-4 pt-3 d-flex gap-3 justify-content-center flex-wrap">
                    <button onclick="window.print()" class="btn btn-outline-dark fw-bold px-4 py-2 shadow-sm">
                        <i class="fa-solid fa-print me-2"></i> Print Receipt
                    </button>
                    <a asp-controller="Customer" asp-action="Dashboard" class="btn btn-brand fw-bold px-4 py-2">
                        <i class="fa-solid fa-house me-2"></i> Return to Dashboard
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>
