@{
    ViewData["HideNavbar"] = true;
}
@model Final_Insure.DTOs.UserLoginDTO
@{
    ViewData["Title"] = "Staff Authentication"; Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-page">
    <div>

        <div class="text-center mb-4">
            <a asp-controller="Home" asp-action="Index" class="auth-brand justify-content-center">
                <div class="auth-logo">
                    <svg viewBox="0 0 24 24"><path d="M12 2L3 6v6c0 5.25 3.75 10.15 9 11.35C17.25 22.15 21 17.25 21 12V6l-9-4zm-1 13l-3-3 1.41-1.41L11 12.17l4.59-4.58L17 9l-6 6z" /></svg>
                </div>
                <span class="auth-brand-name">Shield<em>Insure</em></span>
            </a>
            <p style="color:rgba(255,255,255,.4);font-size:.65rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;margin-top:8px;">INTERNAL STAFF PORTAL</p>
        </div>

        <div class="auth-card">

            <div class="text-center mb-3">
                <h4 class="fw-800 mb-1" style="font-size:1.05rem;letter-spacing:-.4px;">Staff Authentication</h4>
                <p class="text-muted mb-0" style="font-size:.8rem;">Sign in with your secure employee credentials.</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger d-flex align-items-center gap-2 mb-3 py-2 px-3">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    <span>Invalid credentials.</span>
                </div>
            }

            <form asp-controller="Auth" asp-action="Login" method="post">
                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Staff Email</label>
                    <div class="input-wrap">
                        <i class="fa-solid fa-id-badge"></i>
                        <input asp-for="Email" class="form-control" placeholder="employee@shieldinsure.com" required />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small d-block mt-1"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Password" class="form-label">Password</label>
                    <div class="input-wrap">
                        <i class="fa-solid fa-lock"></i>
                        <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" required />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small d-block mt-1"></span>
                </div>

                <button type="submit" class="btn btn-brand w-100 justify-content-center">
                    <i class="fa-solid fa-fingerprint me-2"></i> Authorize Access
                </button>
            </form>

            <div class="text-center mt-3 pt-3" style="border-top:1px solid var(--border);">
                <p class="text-muted mb-0" style="font-size:.8125rem;">
                    New staff?
                    <a asp-controller="Auth" asp-action="RegisterStaff" class="fw-700 text-decoration-none" style="color:var(--brand-primary);">Request Onboarding</a>
                </p>
            </div>
        </div>

        <div class="text-center mt-3">
            <a asp-controller="Home" asp-action="Index" style="color:rgba(255,255,255,.35);font-size:.8125rem;font-weight:600;text-decoration:none;">
                <i class="fa-solid fa-arrow-left me-1"></i> Back to Homepage
            </a>
        </div>

    </div>
</div>
