@model Final_Insure.DTOs.SubmitAssessmentDTO
@{
    ViewData["Title"] = "Submit Assessment";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="card card-shadow-md overflow-hidden">
            <div class="card-header text-white" style="background:#00897b; border-bottom:none!important;">
                <h5 class="mb-0 fw-700">
                    <i class="fa-solid fa-clipboard-check me-2"></i>
                    Field Assessment Report (Claim #@Model.ClaimId)
                </h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="SubmitAssessment" method="post">
                    <input type="hidden" asp-for="ClaimId" />

                    <div class="mb-3">
                        <label asp-for="AssessedAmount" class="form-label">Assessed Repair Amount ($) <span class="text-danger">*</span></label>
                        <input asp-for="AssessedAmount" type="number" step="0.01" class="form-control" placeholder="E.g., 450.00" />
                        <span asp-validation-for="AssessedAmount" class="text-danger" style="font-size:.8rem;"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="SurveyorNotes" class="form-label">Inspection Notes</label>
                        <textarea asp-for="SurveyorNotes" class="form-control" rows="4"
                                  placeholder="Detail the damages observed..."></textarea>
                        <span asp-validation-for="SurveyorNotes" class="text-danger" style="font-size:.8rem;"></span>
                    </div>

                    <div class="alert alert-info mb-4">
                        <i class="fa-solid fa-circle-info me-2"></i>
                        Submitting this assessment will automatically forward the claim to the Compliance Officer for fraud checks.
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-action="Dashboard" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn fw-bold px-4 py-2 text-white shadow-sm" style="background:#00897b;">
                            Submit Assessment
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
