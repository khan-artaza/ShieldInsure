@{
    ViewData["HideNavbar"] = true;
}
@model Final_Insure.DTOs.UserRegisterDTO
@using Final_Insure.Models
@{
    ViewData["Title"] = "Create Account"; Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Added overflow:hidden, reduced padding, and forced centering to prevent scrolling -->
<div class="auth-page">
    <div style="width:100%;max-width:380px;margin:auto;">

        <!-- Reduced mb-5 to mb-3, scaled down logo and text -->
        <div class="text-center mb-3">
            <a asp-controller="Home" asp-action="Index" class="auth-brand justify-content-center">
                <div class="auth-logo" style="width: 32px; height: 32px; border-radius: 8px;">
                    <svg viewBox="0 0 24 24" style="width: 16px; height: 16px;"><path d="M12 2L3 6v6c0 5.25 3.75 10.15 9 11.35C17.25 22.15 21 17.25 21 12V6l-9-4zm-1 13l-3-3 1.41-1.41L11 12.17l4.59-4.58L17 9l-6 6z" /></svg>
                </div>
                <span class="auth-brand-name" style="font-size: 1.15rem;">Shield<em>Insure</em></span>
            </a>
            <p style="color:rgba(255,255,255,.4); font-size:.65rem; font-weight:700; letter-spacing:.12em; text-transform:uppercase; margin-top:6px; margin-bottom: 0;">CUSTOMER ONBOARDING</p>
        </div>

        <!-- Tighter padding inside the card -->
        <div class="auth-card" style="padding: 20px;">
            <div class="text-center mb-3">
                <h4 class="fw-800 mb-1" style="letter-spacing:-.4px; font-size: 1.1rem;">Create your account</h4>
                <p class="text-muted mb-0" style="font-size:.75rem;">Get instant policies and 48-hour claim settlements.</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <!-- Shrunk alert box -->
                <div class="alert alert-danger mb-3" style="padding: 8px 12px; font-size: .75rem;">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    <span>Please correct the errors below.</span>
                </div>
            }

            <form asp-controller="Auth" asp-action="Register" method="post">
                <!-- Reduced margin gaps between inputs -->
                <div class="mb-2">
                    <label asp-for="Username" class="form-label" style="font-size:.7rem; margin-bottom:4px;">Full Name</label>
                    <div class="input-wrap">
                        <i class="fa-solid fa-user" style="font-size:.75rem;"></i>
                        <!-- Shrunk input text and padding -->
                        <input asp-for="Username" class="form-control" style="font-size:.8rem; padding: 6px 12px 6px 36px; min-height: 34px;" placeholder="e.g. John Doe" required />
                    </div>
                    <span asp-validation-for="Username" class="text-danger small d-block mt-1" style="font-size: .65rem;"></span>
                </div>

                <div class="mb-2">
                    <label asp-for="Email" class="form-label" style="font-size:.7rem; margin-bottom:4px;">Email Address</label>
                    <div class="input-wrap">
                        <i class="fa-solid fa-envelope" style="font-size:.75rem;"></i>
                        <input asp-for="Email" type="email" class="form-control" style="font-size:.8rem; padding: 6px 12px 6px 36px; min-height: 34px;" placeholder="name@example.com" required />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small d-block mt-1" style="font-size: .65rem;"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label" style="font-size:.7rem; margin-bottom:4px;">Password</label>
                    <div class="input-wrap">
                        <i class="fa-solid fa-lock" style="font-size:.75rem;"></i>
                        <input asp-for="Password" type="password" class="form-control" style="font-size:.8rem; padding: 6px 12px 6px 36px; min-height: 34px;" placeholder="••••••••" required />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small d-block mt-1" style="font-size: .65rem;"></span>
                </div>
                <input type="hidden" asp-for="Role" value="@UserRole.Customer" />

                <!-- Button text scaled down, padding reduced -->
                <button type="submit" class="btn w-100 fw-800 d-flex justify-content-center align-items-center" style="background:linear-gradient(135deg,#38bdf8,#0284c7);color:#ffffff;padding:9px;font-size:.85rem;border-radius:var(--r-md);">
                    Create Account <i class="fa-solid fa-user-plus ms-2"></i>
                </button>
            </form>

            <div class="text-center mt-3 pt-3" style="border-top:1px solid var(--border);">
                <p class="text-muted mb-0" style="font-size:.75rem;">
                    Already have an account?
                    <a asp-controller="Auth" asp-action="Login" class="fw-700 text-decoration-none" style="color:var(--brand-primary);">Sign In</a>
                </p>
            </div>
        </div>

        <div class="text-center mt-3">
            <a asp-controller="Home" asp-action="Index" style="color:rgba(255,255,255,.35);font-size:.75rem;font-weight:600;text-decoration:none;">
                <i class="fa-solid fa-arrow-left me-1"></i> Back to Homepage
            </a>
        </div>

    </div>
</div>