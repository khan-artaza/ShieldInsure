@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-7 col-lg-5">
        <div class="card card-shadow-md text-center p-5">
            <div class="mb-4">
                <div class="rounded-circle bg-danger bg-opacity-10 text-danger d-inline-flex align-items-center justify-content-center"
                     style="width:72px; height:72px; font-size:2rem;">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
            </div>
            <h2 class="fw-800 text-danger mb-2">An Error Occurred</h2>
            <p class="text-muted mb-4">An unexpected error occurred while processing your request.</p>

            @if (Model.ShowRequestId)
            {
                <div class="p-3 rounded-3 border mb-4 text-start" style="background:#f8fafc;">
                    <p class="text-muted mb-1" style="font-size:.75rem; font-weight:700; text-transform:uppercase; letter-spacing:.06em;">Request ID</p>
                    <code class="text-dark fw-600">@Model.RequestId</code>
                </div>
            }

            <div class="p-3 rounded-3 border text-start mb-4" style="background:#fffbeb; border-color:#fcd34d!important;">
                <h6 class="fw-700 text-warning mb-2">Development Mode</h6>
                <p class="text-muted mb-1" style="font-size:.85rem;">
                    Swapping to <strong>Development</strong> environment will display more detailed error information.
                </p>
                <p class="text-muted mb-0" style="font-size:.85rem;">
                    Set <code>ASPNETCORE_ENVIRONMENT</code> to <code>Development</code> and restart the app.
                </p>
            </div>

            <a asp-controller="Home" asp-action="Index" class="btn btn-brand px-4 py-2">
                <i class="fa-solid fa-house me-2"></i> Back to Home
            </a>
        </div>
    </div>
</div>
