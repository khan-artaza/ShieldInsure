@model IEnumerable<Final_Insure.Models.Policy>
@{
    ViewData["Title"] = "Insurance Catalog";
}

<style>
    .plan-card {
        transition: transform .25s ease, box-shadow .25s ease;
        display: flex;
        flex-direction: column;
        height: 100%; /* Ensures equal height */
    }

        .plan-card:hover {
            transform: translateY(-4px); /* Slightly subtler hover effect */
            box-shadow: 0 15px 35px rgba(12,56,122,.12) !important;
        }

    .plan-header {
        background: linear-gradient(135deg, #0c387a, #1a56c4);
        padding: 1rem; /* Reduced from 1.75rem */
        text-align: center;
    }

    .card-body {
        flex-grow: 1; /* Expands body to fill space */
        display: flex;
        flex-direction: column;
    }
</style>

<div class="page-header mb-4">
    <div>
        <span class="badge badge-soft-primary rounded-pill px-3 mb-1 fw-bold" style="font-size:.72rem;">POLICY CATALOG</span>
        <h2 class="page-header-title">Available Insurance Plans</h2>
        <p class="page-header-subtitle text-muted">Browse our latest insurance offerings and protect what matters most.</p>
    </div>
</div>

<div class="row g-3">
    <!-- Reduced grid gap from g-4 to g-3 -->
    @if (Model != null && Model.Any())
    {
        foreach (var plan in Model)
        {
            <div class="col-md-4 d-flex">
                <div class="card plan-card w-100 overflow-hidden shadow-sm">
                    <div class="plan-header">
                        <h5 class="fw-bold text-white mb-1">@plan.PolicyType Insurance</h5> <!-- Reduced from h4 -->
                        <span class="badge bg-white bg-opacity-20 text-black-50 font-mono" style="font-size:.70rem;">@plan.PolicyNumber</span>
                    </div>

                    <!-- Reduced padding from p-4 to p-3 -->
                    <div class="card-body p-3 d-flex flex-column">
                        <div class="text-center my-2">
                            <!-- Reduced margin from my-3 to my-2 -->
                            <h3 class="fw-bold text-success mb-1">$@plan.PremiumAmount.ToString("0.00")</h3> <!-- Reduced from h2 -->
                            <span class="text-muted fw-semibold" style="font-size:.70rem; text-transform:uppercase; letter-spacing:.06em;">Monthly Premium</span>
                        </div>

                        <hr class="my-2 opacity-25"> <!-- Reduced margin from my-3 to my-2 -->
                        <!-- Reduced margin from mb-4 to mb-3 -->
                        <ul class="list-unstyled mb-3" style="font-size:.85rem;">
                            <!-- Reduced li spacing from mb-3 to mb-2 -->
                            <li class="d-flex align-items-center gap-2 mb-2">
                                <i class="bi bi-check-circle-fill text-success fs-6 flex-shrink-0"></i> <!-- Reduced icon size -->
                                <span><strong>Coverage:</strong> $@plan.CoverageAmount.ToString("N0")</span>
                            </li>
                            <li class="d-flex align-items-center gap-2 mb-2">
                                <i class="bi bi-check-circle-fill text-success fs-6 flex-shrink-0"></i>
                                <span><strong>Status:</strong> Active &amp; Ready</span>
                            </li>
                            <li class="d-flex align-items-start gap-2">
                                <i class="bi bi-check-circle-fill text-success fs-6 flex-shrink-0 mt-1"></i>
                                <span>Instant Digital Approval &amp; Policy Document</span>
                            </li>
                        </ul>

                        <div class="mt-auto">
                            <a asp-action="Checkout" asp-route-planId="@plan.PolicyId"
                               class="btn btn-brand w-100 py-2 fw-bold">
                                <!-- Reduced padding from py-3 to py-2 -->
                                Buy Now <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="empty-state card py-4 text-center shadow-sm">
                <i class="bi bi-inbox empty-state-icon fs-1 text-muted mb-2"></i>
                <h5 class="empty-state-title fw-bold">No Policies Available</h5>
                <p class="empty-state-text text-muted mb-0">Please check back later or contact support assistance.</p>
            </div>
        </div>
    }
</div>