@model Final_Insure.DTOs.CheckoutDTO
@{
    ViewData["Title"] = "Secure Checkout";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">

        <div class="card card-shadow-md overflow-hidden">
            <!-- Header -->
            <div class="card-header text-white d-flex align-items-center justify-content-between"
                 style="background:linear-gradient(135deg,#0c387a,#1856b5); border-bottom:none!important; padding:1.25rem 1.5rem;">
                <h5 class="mb-0 fw-700 text-white">
                    <i class="fa-solid fa-lock me-2 opacity-75"></i> Secure Checkout
                </h5>
               
            </div>

            <div class="card-body p-4">

                <!-- Order Summary Box -->
                <div class="rounded-3 border p-4 mb-4" style="background:#f8fafc;">
                    <h6 class="fw-700 text-brand mb-3">
                        <i class="fa-solid fa-receipt me-2"></i> Order Summary
                    </h6>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted" style="font-size:.875rem;">Selected Plan</span>
                        <span class="fw-bold">@Model.PlanName</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted" style="font-size:.875rem;">Max Coverage</span>
                        <span class="fw-bold text-success">$@Model.CoverageAmount.ToString("N0")</span>
                    </div>
                    <hr class="my-3 opacity-25">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-700">Total Premium</span>
                        <span class="fw-800 fs-5 text-dark">$@Model.PremiumAmount.ToString("N2")</span>
                    </div>
                </div>

                <!-- Vehicle Details Form -->
                <h6 class="fw-700 text-brand mb-3">
                    <i class="fa-solid fa-car me-2"></i> Vehicle Details
                </h6>

                <form asp-action="Checkout" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="PlanId" />
                    <input type="hidden" asp-for="PlanName" />
                    <input type="hidden" asp-for="PremiumAmount" />
                    <input type="hidden" asp-for="CoverageAmount" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="VehicleRC" class="form-label">Vehicle RC Number <span class="text-danger">*</span></label>
                            <input asp-for="VehicleRC" class="form-control" placeholder="e.g. MH-01-AB-1234" />
                            <span asp-validation-for="VehicleRC" class="text-danger" style="font-size:.8rem;"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ChassisNumber" class="form-label">Chassis Number <span class="text-danger">*</span></label>
                            <input asp-for="ChassisNumber" class="form-control" placeholder="17-character VIN" />
                            <span asp-validation-for="ChassisNumber" class="text-danger" style="font-size:.8rem;"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                        <a asp-action="BuyPolicy" class="btn btn-link text-muted text-decoration-none fw-600 ps-0">
                            <i class="fa-solid fa-arrow-left me-1"></i> Back to Plans
                        </a>
                        <button type="submit" class="btn btn-success btn-lg px-5 fw-bold shadow-sm">
                            <i class="fa-solid fa-credit-card me-2"></i>
                            Pay $@Model.PremiumAmount.ToString("N0") &amp; Generate Policy
                        </button>
                    </div>
                </form>

            </div>
        </div>

    </div>
</div>
