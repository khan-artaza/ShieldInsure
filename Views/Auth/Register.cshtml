@model Final_Insure.DTOs.UserRegisterDTO
@using Final_Insure.Models
@{ ViewData["Title"] = "Create Account"; Layout = "~/Views/Shared/_Layout.cshtml"; }

<div class="auth-page">
  <div style="width:100%;max-width:440px;">

    <div class="text-center mb-5">
      <a asp-controller="Home" asp-action="Index" class="auth-brand justify-content-center">
        <div class="auth-logo">
          <svg viewBox="0 0 24 24"><path d="M12 2L3 6v6c0 5.25 3.75 10.15 9 11.35C17.25 22.15 21 17.25 21 12V6l-9-4zm-1 13l-3-3 1.41-1.41L11 12.17l4.59-4.58L17 9l-6 6z"/></svg>
        </div>
        <span class="auth-brand-name">Shield<em>Insure</em></span>
      </a>
      <p style="color:rgba(255,255,255,.4);font-size:.72rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;margin-top:8px;">CUSTOMER ONBOARDING</p>
    </div>

    <div class="auth-card">
      <div class="text-center mb-4">
        <h4 class="fw-800 mb-1" style="letter-spacing:-.4px;">Create your account</h4>
        <p class="text-muted mb-0" style="font-size:.875rem;">Get instant policies and 48-hour claim settlements.</p>
      </div>

      @if (!ViewData.ModelState.IsValid)
      {
        <div class="alert alert-danger mb-4">
          <i class="fa-solid fa-triangle-exclamation"></i>
          <span>Please correct the errors below before proceeding.</span>
        </div>
      }

      <form asp-controller="Auth" asp-action="Register" method="post">
        <div class="mb-3">
          <label asp-for="Username" class="form-label">Full Name</label>
          <div class="input-wrap">
            <i class="fa-solid fa-user"></i>
            <input asp-for="Username" class="form-control" placeholder="e.g. John Doe" required />
          </div>
          <span asp-validation-for="Username" class="text-danger small d-block mt-1"></span>
        </div>
        <div class="mb-3">
          <label asp-for="Email" class="form-label">Email Address</label>
          <div class="input-wrap">
            <i class="fa-solid fa-envelope"></i>
            <input asp-for="Email" type="email" class="form-control" placeholder="name@example.com" required />
          </div>
          <span asp-validation-for="Email" class="text-danger small d-block mt-1"></span>
        </div>
        <div class="mb-5">
          <label asp-for="Password" class="form-label">Password</label>
          <div class="input-wrap">
            <i class="fa-solid fa-lock"></i>
            <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" required />
          </div>
          <span asp-validation-for="Password" class="text-danger small d-block mt-1"></span>
        </div>
        <input type="hidden" asp-for="Role" value="@UserRole.Customer" />
        <button type="submit" class="btn w-100 fw-800" style="background:linear-gradient(135deg,#38bdf8,#0284c7);color:#0c1a2e;padding:13px;font-size:.9375rem;border-radius:var(--r-md);">
          Create Account <i class="fa-solid fa-user-plus ms-2"></i>
        </button>
      </form>

      <div class="text-center mt-4 pt-4" style="border-top:1px solid var(--border);">
        <p class="text-muted mb-0" style="font-size:.875rem;">
          Already have an account?
          <a asp-controller="Auth" asp-action="Login" class="fw-700 text-decoration-none" style="color:var(--brand-primary);">Sign In</a>
        </p>
      </div>
    </div>

    <div class="text-center mt-4">
      <a asp-controller="Home" asp-action="Index" style="color:rgba(255,255,255,.35);font-size:.8125rem;font-weight:600;text-decoration:none;">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to Homepage
      </a>
    </div>

  </div>
</div>
