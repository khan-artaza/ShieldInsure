@model Final_Insure.Models.User
@{
    ViewData["Title"] = "My Profile";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="card card-shadow-md">
            <div class="card-header text-white" style="background:linear-gradient(135deg,#0c387a,#1856b5); border-bottom:none!important;">
                <h5 class="mb-0 fw-700">
                    <i class="fa-solid fa-circle-user me-2"></i> User Profile
                </h5>
            </div>
            <div class="card-body p-4">

                <div class="text-center mb-4 pb-3 border-bottom">
                    <div class="rounded-circle bg-primary text-white fw-800 d-inline-flex align-items-center justify-content-center shadow-sm mb-3"
                         style="width:72px; height:72px; font-size:1.75rem;">
                        @Model.Username.Substring(0, 1).ToUpper()
                    </div>
                    <h5 class="fw-800 mb-1">@Model.Username</h5>
                    <span class="badge badge-soft-secondary rounded-pill px-3">@Model.Role</span>
                </div>

                <div class="detail-row">
                    <span class="detail-label"><i class="fa-solid fa-envelope me-2 text-muted"></i>Email Address</span>
                    <span class="detail-value text-muted">@Model.Email</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label"><i class="fa-solid fa-circle-dot me-2 text-muted"></i>Account Status</span>
                    <span class="detail-value">
                        @if (Model.IsApproved)
                        {
                            <span class="badge badge-soft-success rounded-pill px-3">Active &amp; Verified</span>
                        }
                        else
                        {
                            <span class="badge badge-soft-warning rounded-pill px-3">Pending Approval</span>
                        }
                    </span>
                </div>
                <div class="detail-row">
                    <span class="detail-label"><i class="fa-solid fa-calendar me-2 text-muted"></i>Member Since</span>
                    <span class="detail-value text-muted">@Model.CreatedAt.ToString("MMMM dd, yyyy")</span>
                </div>

                <div class="mt-4 d-grid">
                    <a href="javascript:history.back()" class="btn btn-outline-primary fw-bold py-2">
                        <i class="fa-solid fa-arrow-left me-2"></i> Back to Dashboard
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>
