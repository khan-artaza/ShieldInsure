@model Final_Insure.Models.Policy
@{
    ViewData["Title"] = "Create New Policy";
}

<div class="row justify-content-center">
    <div class="col-lg-9 col-xl-8">
        <div class="card card-shadow-md overflow-hidden">
            <div class="card-header text-white"
                 style="background:linear-gradient(135deg,#0c387a,#1856b5); border-bottom:none!important;">
                <h5 class="mb-0 fw-700">
                    <i class="fa-solid fa-cloud-arrow-up me-2"></i> Publish a New Insurance Policy
                </h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="CreatePolicy" method="post">
                    <input type="hidden" asp-for="Status" value="Active" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="PolicyNumber" class="form-label">Policy Number <span class="text-danger">*</span></label>
                            <input asp-for="PolicyNumber" class="form-control" placeholder="e.g., POL-2026-AUTO-01" required />
                            <span asp-validation-for="PolicyNumber" class="text-danger" style="font-size:.8rem;"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PolicyType" class="form-label">Policy Type <span class="text-danger">*</span></label>
                            <select asp-for="PolicyType" class="form-select" required>
                                <option value="">— Select Type —</option>
                                <option value="Auto">Auto Insurance</option>
                                <option value="Health">Health Insurance</option>
                                <option value="Property">Property Insurance</option>
                                <option value="Life">Life Insurance</option>
                            </select>
                            <span asp-validation-for="PolicyType" class="text-danger" style="font-size:.8rem;"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="CoverageAmount" class="form-label">Coverage Amount ($) <span class="text-danger">*</span></label>
                            <input asp-for="CoverageAmount" type="number" step="0.01" class="form-control" placeholder="50000.00" required />
                            <span asp-validation-for="CoverageAmount" class="text-danger" style="font-size:.8rem;"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PremiumAmount" class="form-label">Monthly Premium ($) <span class="text-danger">*</span></label>
                            <input asp-for="PremiumAmount" type="number" step="0.01" class="form-control" placeholder="150.00" required />
                            <span asp-validation-for="PremiumAmount" class="text-danger" style="font-size:.8rem;"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="StartDate" class="form-label">Availability Start Date <span class="text-danger">*</span></label>
                            <input asp-for="StartDate" type="date" class="form-control" required />
                            <span asp-validation-for="StartDate" class="text-danger" style="font-size:.8rem;"></span>
                        </div>
                        <div class="col-md-6 mb-4">
                            <label asp-for="EndDate" class="form-label">Availability End Date <span class="text-danger">*</span></label>
                            <input asp-for="EndDate" type="date" class="form-control" required />
                            <span asp-validation-for="EndDate" class="text-danger" style="font-size:.8rem;"></span>
                        </div>
                    </div>

                    <div class="p-3 rounded-3 border mb-4" style="background:#f8fafc;">
                        <h6 class="fw-700 mb-3 text-muted" style="font-size:.8rem; text-transform:uppercase; letter-spacing:.06em;">
                            Vehicle Specific Details <span class="fw-400 text-muted">(Optional)</span>
                        </h6>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="VehicleRC" class="form-label">Vehicle RC (If Auto)</label>
                                <input asp-for="VehicleRC" class="form-control" placeholder="Leave blank if not auto policy" />
                                <span asp-validation-for="VehicleRC" class="text-danger" style="font-size:.8rem;"></span>
                            </div>
                            <div class="col-md-6 mb-1">
                                <label asp-for="ChassisNumber" class="form-label">Chassis Number</label>
                                <input asp-for="ChassisNumber" class="form-control" placeholder="Leave blank if not auto policy" />
                                <span asp-validation-for="ChassisNumber" class="text-danger" style="font-size:.8rem;"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-action="Dashboard" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-success px-5 fw-bold py-2 shadow-sm">
                            <i class="fa-solid fa-cloud-arrow-up me-2"></i> Publish Policy
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
