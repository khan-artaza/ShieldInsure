@model Final_Insure.Models.Claim
@using Final_Insure.Models
@{
    ViewData["Title"] = "Review Claim & Assign Surveyor";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var availableSurveyors = ViewBag.AvailableSurveyors as IEnumerable<dynamic>;
}

<div class="page-header">
    <div>
        <h1 class="page-header-title">Claim Review: #CLM-@Model.ClaimId.ToString("D4")</h1>
        <p class="page-header-subtitle">Review incident details, inspect evidence, and assign a Surveyor.</p>
    </div>
    <a asp-action="Dashboard" class="btn btn-outline-secondary fw-600">
        <i class="fa-solid fa-arrow-left me-2"></i> Back to Dashboard
    </a>
</div>

<div class="row g-4">
    <!-- Left: Claim Details & Documents -->
    <div class="col-lg-8">
        <!-- Incident Card -->
        <div class="card card-shadow-md mb-4 overflow-hidden">
            <div class="card-header bg-dark text-white" style="border-bottom:none!important;">
                <h5 class="mb-0 fw-700">
                    <i class="fa-solid fa-file-lines me-2"></i> Incident Details
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="row mb-3 g-3">
                    <div class="col-md-4">
                        <p class="text-muted mb-1" style="font-size:.75rem; font-weight:700; text-transform:uppercase;">Incident Date</p>
                        <p class="fw-600 mb-0">@Model.IncidentDate.ToString("MMM dd, yyyy")</p>
                    </div>
                    <div class="col-md-4">
                        <p class="text-muted mb-1" style="font-size:.75rem; font-weight:700; text-transform:uppercase;">Claim Type</p>
                        <p class="fw-600 mb-0">@Model.ClaimType</p>
                    </div>
                    <div class="col-md-4">
                        <p class="text-muted mb-1" style="font-size:.75rem; font-weight:700; text-transform:uppercase;">Requested Payout</p>
                        <p class="fw-800 text-brand fs-5 mb-0">$@Model.ClaimAmount.ToString("N0")</p>
                    </div>
                </div>
                <hr class="opacity-25">
                <h6 class="fw-700 mb-2">Description of Incident</h6>
                <p class="text-muted p-3 border rounded-3 mb-0" style="background:#f8fafc; font-size:.875rem;">@Model.Description</p>
            </div>
        </div>

        <!-- Documents Card -->
        <div class="card card-shadow-md overflow-hidden">
            <div class="card-header bg-secondary text-white" style="border-bottom:none!important;">
                <h5 class="mb-0 fw-700">
                    <i class="fa-solid fa-paperclip me-2"></i> Uploaded Evidence &amp; Documents
                </h5>
            </div>
            <div class="card-body p-4">
                @if (Model.ClaimDocuments != null && Model.ClaimDocuments.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var doc in Model.ClaimDocuments)
                        {
                            <a href="@doc.FilePath" target="_blank"
                               class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                <div>
                                    <i class="fa-solid fa-file-image text-primary me-2"></i>
                                    <strong style="font-size:.875rem;">@doc.DocumentName</strong><br />
                                    <small class="text-muted">Uploaded on @doc.UploadedAt.ToString("MMM dd, yyyy")</small>
                                </div>
                                <span class="btn btn-xs btn-outline-primary rounded-pill">
                                    <i class="fa-solid fa-eye me-1"></i> View File
                                </span>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-warning mb-0">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i>
                        The customer did not upload any supporting documents.
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Right: Surveyor Assignment Form -->
    <div class="col-lg-4">
        <div class="card card-shadow-lg overflow-hidden" style="position:sticky; top:76px;">
            <div class="card-header text-white"
                 style="background:linear-gradient(135deg,#0c387a,#1856b5); border-bottom:none!important;">
                <h5 class="mb-0 fw-700">
                    <i class="fa-solid fa-user-check me-2"></i> Assign Surveyor
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-info mb-4">
                    <i class="fa-solid fa-circle-info me-2"></i>
                    Select an available Surveyor Officer to physically inspect the vehicle and assess the damage.
                </div>

                <form asp-action="AssignSurveyor" method="post">
                    <input type="hidden" name="claimId" value="@Model.ClaimId" />

                    <div class="mb-4">
                        <label class="form-label">Select Surveyor Officer <span class="text-danger">*</span></label>
                        <select name="surveyorId" class="form-select" required>
                            <option value="">— Choose an available Surveyor —</option>
                            @if (availableSurveyors != null)
                            {
                                foreach (var surveyor in availableSurveyors)
                                {
                                    <option value="@surveyor.Email">@surveyor.Username</option>
                                }
                            }
                        </select>
                    </div>

                    <button type="submit" class="btn btn-warning w-100 fw-bold py-3 text-dark">
                        Assign &amp; Transfer Claim <i class="fa-solid fa-paper-plane ms-2"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
