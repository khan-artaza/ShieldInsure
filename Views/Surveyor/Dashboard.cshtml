@model IEnumerable<Final_Insure.Models.Claim>
@{
    ViewData["Title"] = "Surveyor Field Desk";
}

<div class="container-fluid py-2">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bolder text-dark mb-1">Field Surveyor Desk</h3>
            <p class="text-muted mb-0">Manage your assigned vehicle inspections and submit assessments.</p>
        </div>
    </div>

    <!-- Success Message Alert -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-3 mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- PENDING INSPECTIONS TABLE -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-bottom py-3">
            <h6 class="mb-0 fw-bold" style="color: #00897B;"><i class="fa-solid fa-clipboard-list me-2"></i> Claims Pending Inspection</h6>
        </div>
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-muted">
                            <tr>
                                <th class="ps-4">Claim ID</th>
                                <th>Incident Date</th>
                                <th>Vehicle Location</th>
                                <th>Requested Amount</th>
                                <th class="text-end pe-4">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var claim in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-dark">#CLM-@claim.ClaimId.ToString("D4")</td>
                                    <td>@claim.IncidentDate.ToString("MMM dd, yyyy")</td>
                                    <td><i class="fa-solid fa-location-dot text-danger me-1"></i> @claim.AccidentAddress</td>
                                    <td class="fw-semibold text-primary">$@claim.ClaimAmount.ToString("N0")</td>
                                    <td class="text-end pe-4">
                                        <a asp-action="InspectVehicle" asp-route-id="@claim.ClaimId" class="btn btn-sm text-white fw-semibold shadow-sm" style="background: #00897B;">
                                            Start Inspection <i class="fa-solid fa-camera ms-1"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-5 text-center text-muted">
                    <i class="fa-solid fa-mug-hot fs-1 mb-3 text-secondary opacity-50 d-block"></i>
                    <h6 class="fw-semibold text-dark">No Pending Inspections</h6>
                    <p class="small mb-0">You have no claims assigned to you right now. Take a break!</p>
                </div>
            }
        </div>
    </div>
</div>