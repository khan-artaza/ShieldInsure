@model IEnumerable<Final_Insure.Models.Claim>
@{
    ViewData["Title"] = "Surveyor Field Desk";
    int pendingCount = Model?.Count() ?? 0;
}

<style>
.surv-stat { border-radius:16px;border:1px solid #e8eef5;background:#fff;padding:1.4rem 1.6rem;display:flex;align-items:center;gap:1rem;transition:all .22s ease;box-shadow:0 1px 6px rgba(0,0,0,.04); }
.surv-stat:hover { box-shadow:0 8px 28px rgba(0,137,123,.12);transform:translateY(-3px); }
.surv-stat-icon { width:52px;height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:1.3rem;flex-shrink:0; }
.surv-stat-label { font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:#64748b;margin-bottom:3px; }
.surv-stat-value { font-size:2rem;font-weight:900;line-height:1;color:#0f172a; }
.surv-stage-card { border-radius:16px;border:1px solid #e8eef5;background:#fff;overflow:hidden;box-shadow:0 1px 6px rgba(0,0,0,.04); }
.surv-stage-hdr { display:flex;align-items:center;justify-content:space-between;padding:.9rem 1.25rem;border-bottom:1px solid #f1f5f9; }
</style>

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-header-title" style="display:flex;align-items:center;gap:.5rem;">
            <span style="display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;background:linear-gradient(135deg,#00897b,#00695c);border-radius:10px;">
                <i class="fa-solid fa-camera-retro text-white" style="font-size:.9rem;"></i>
            </span>
            Field Surveyor Desk
        </h1>
        <p class="page-header-subtitle">Manage your assigned vehicle inspections and submit field assessments.</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="surv-stat">
            <div class="surv-stat-icon" style="background:rgba(0,137,123,.1);color:#00897b;">
                <i class="fa-solid fa-clipboard-list"></i>
            </div>
            <div>
                <div class="surv-stat-label">Pending Inspections</div>
                <div class="surv-stat-value" style="color:#00897b;">@pendingCount</div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="surv-stat">
            <div class="surv-stat-icon" style="background:#fff7ed;color:#ea580c;">
                <i class="fa-solid fa-location-dot"></i>
            </div>
            <div>
                <div class="surv-stat-label">Site Visits Due</div>
                <div class="surv-stat-value" style="color:#ea580c;">@pendingCount</div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="surv-stat">
            <div class="surv-stat-icon" style="background:#ecfdf5;color:#059669;">
                <i class="fa-solid fa-check-double"></i>
            </div>
            <div>
                <div class="surv-stat-label">Completed Today</div>
                <div class="surv-stat-value" style="color:#059669;">0</div>
            </div>
        </div>
    </div>
</div>

<!-- Inspections Table -->
<div class="surv-stage-card">
    <div class="surv-stage-hdr">
        <h6 style="font-size:.875rem;font-weight:700;display:flex;align-items:center;gap:8px;margin:0;">
            <span style="width:30px;height:30px;border-radius:8px;background:rgba(0,137,123,.1);display:flex;align-items:center;justify-content:center;">
                <i class="fa-solid fa-clipboard-list" style="color:#00897b;font-size:.8rem;"></i>
            </span>
            Claims Pending Field Inspection
        </h6>
        @if (pendingCount > 0)
        {
            <span class="badge rounded-pill px-3 py-1 fw-700" style="background:rgba(0,137,123,.1);color:#00897b;border:1px solid rgba(0,137,123,.25);font-size:.72rem;">
                @pendingCount Assigned
            </span>
        }
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead><tr>
                    <th class="ps-4">Claim ID</th>
                    <th>Incident Date</th>
                    <th>Vehicle Location</th>
                    <th>Requested Amount</th>
                    <th class="text-end pe-4">Action</th>
                </tr></thead>
                <tbody>
                @foreach (var claim in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <span class="fw-800" style="font-family:monospace;font-size:.85rem;color:#00897b;">#CLM-@claim.ClaimId.ToString("D4")</span>
                        </td>
                        <td style="color:#64748b;font-size:.875rem;">@claim.IncidentDate.ToString("MMM dd, yyyy")</td>
                        <td style="font-size:.875rem;">
                            <i class="fa-solid fa-location-dot text-danger me-1"></i>
                            @claim.AccidentAddress
                        </td>
                        <td class="fw-800" style="color:#0c387a;">$@claim.ClaimAmount.ToString("N0")</td>
                        <td class="text-end pe-4">
                            <a asp-action="InspectVehicle" asp-route-id="@claim.ClaimId"
                               style="display:inline-flex;align-items:center;gap:5px;padding:6px 14px;border-radius:8px;font-size:.8rem;font-weight:700;background:#00897b;color:#fff;text-decoration:none;transition:all .2s;">
                                <i class="fa-solid fa-camera"></i> Start Inspection
                            </a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="fa-solid fa-mug-hot empty-state-icon" style="color:rgba(0,137,123,.3);"></i>
            <p class="empty-state-title">All Clear — No Pending Inspections</p>
            <p class="empty-state-text">You have no claims assigned right now. Take a well-deserved break!</p>
        </div>
    }
</div>
