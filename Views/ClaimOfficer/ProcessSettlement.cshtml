@model Final_Insure.DTOs.ProcessSettlementDTO
@using Final_Insure.Models
@{
    ViewData["Title"] = "Final Settlement Processing";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var claim = ViewBag.ClaimData as Claim;
    var assessment = ViewBag.AssessmentData as Assessment;
}

<div class="page-header">
    <div>
        <h1 class="page-header-title">
            <i class="fa-solid fa-file-invoice-dollar me-2 text-brand"></i> Final Claim Settlement
        </h1>
        <p class="page-header-subtitle">Review all department reports and authorize final payout or rejection.</p>
    </div>
    <a asp-action="Dashboard" class="btn btn-outline-secondary fw-600">
        <i class="fa-solid fa-arrow-left me-2"></i> Back to Dashboard
    </a>
</div>

<div class="row g-4">
    <!-- Left: Case History -->
    <div class="col-lg-7">
        <div class="card card-shadow-md overflow-hidden h-100">
            <div class="card-header text-white d-flex justify-content-between align-items-center"
                 style="background:#1e293b; border-bottom:none!important;">
                <h5 class="mb-0 fw-700">
                    <i class="fa-solid fa-book-open-reader me-2"></i> Complete Case Master File
                </h5>
                <span class="badge badge-soft-secondary rounded-pill">
                    ID: #CLM-@Model.ClaimId.ToString("D4")
                </span>
            </div>
            <div class="card-body p-0" style="max-height:680px; overflow-y:auto;">

                <!-- 1. Customer Request -->
                <div class="p-4 border-bottom">
                    <h6 class="fw-700 mb-3 text-brand" style="font-size:.78rem; text-transform:uppercase; letter-spacing:.08em;">
                        <i class="fa-solid fa-user me-2"></i> 1. Customer Claim Request
                    </h6>
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <p class="text-muted mb-1" style="font-size:.78rem; font-weight:700; text-transform:uppercase;">Incident Date</p>
                            <p class="fw-600 mb-0">@claim?.IncidentDate.ToString("MMM dd, yyyy")</p>
                        </div>
                        <div class="col-sm-6">
                            <p class="text-muted mb-1" style="font-size:.78rem; font-weight:700; text-transform:uppercase;">Requested Amount</p>
                            <p class="fw-800 text-danger fs-5 mb-0">$@claim?.ClaimAmount.ToString("N0")</p>
                        </div>
                        <div class="col-12">
                            <p class="text-muted mb-1" style="font-size:.78rem; font-weight:700; text-transform:uppercase;">Customer Statement</p>
                            <p class="p-3 rounded-3 border mb-0" style="background:#f8fafc; font-size:.875rem;">@claim?.Description</p>
                        </div>
                    </div>
                </div>

                <!-- 2. Surveyor Report -->
                <div class="p-4 border-bottom" style="background:#f8fafc;">
                    <h6 class="fw-700 mb-3 text-success" style="font-size:.78rem; text-transform:uppercase; letter-spacing:.08em;">
                        <i class="fa-solid fa-clipboard-check me-2"></i> 2. Surveyor Field Report
                    </h6>
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <p class="text-muted mb-1" style="font-size:.78rem; font-weight:700; text-transform:uppercase;">Assessed Repair Cost</p>
                            <p class="fw-800 text-success fs-5 mb-0">
                                $@(assessment != null ? assessment.AssessedAmount.ToString("N0") : "Pending")
                            </p>
                        </div>
                        <div class="col-sm-6">
                            <p class="text-muted mb-1" style="font-size:.78rem; font-weight:700; text-transform:uppercase;">Story Matches Damage</p>
                            <span class="badge badge-soft-success rounded-pill px-3">Yes Verified</span>
                        </div>
                        <div class="col-12">
                            <p class="text-muted mb-1" style="font-size:.78rem; font-weight:700; text-transform:uppercase;">Surveyor Remarks</p>
                            <p class="text-muted mb-0" style="font-size:.875rem;">Physical inspection complete. Damage is consistent with the described incident.</p>
                        </div>
                    </div>
                </div>

                <!-- 3. Compliance Report -->
                <div class="p-4">
                    <h6 class="fw-700 mb-3 text-danger" style="font-size:.78rem; text-transform:uppercase; letter-spacing:.08em;">
                        <i class="fa-solid fa-shield-halved me-2"></i> 3. Compliance &amp; Fraud Audit
                    </h6>
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <p class="text-muted mb-1" style="font-size:.78rem; font-weight:700; text-transform:uppercase;">Fraud Risk Score</p>
                            <span class="badge badge-soft-success rounded-pill px-3 py-2">25/100 (Low Risk)</span>
                        </div>
                        <div class="col-sm-6">
                            <p class="text-muted mb-1" style="font-size:.78rem; font-weight:700; text-transform:uppercase;">Audit Status</p>
                            <span class="text-success fw-700">
                                <i class="fa-solid fa-check-circle me-1"></i> Cleared for Payout
                            </span>
                        </div>
                        <div class="col-12">
                            <p class="text-muted mb-1" style="font-size:.78rem; font-weight:700; text-transform:uppercase;">Compliance Remarks</p>
                            <p class="text-muted mb-0" style="font-size:.875rem;">No fraudulent activity detected. Policy was active at the time of the incident.</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Right: Settlement Form -->
    <div class="col-lg-5">
        <div class="card card-shadow-lg overflow-hidden" style="position:sticky; top:76px;">
            <div class="card-header text-white"
                 style="background:linear-gradient(135deg,#0c387a,#1856b5); border-bottom:none!important;">
                <h5 class="mb-0 fw-700">
                    <i class="fa-solid fa-money-check-dollar me-2"></i> Issue Final Decision
                </h5>
            </div>
            <div class="card-body p-4">

                <div class="alert alert-info mb-4">
                    <i class="fa-solid fa-circle-info me-2"></i>
                    You are legally authorizing the final status of this claim. This action cannot be undone.
                </div>

                <form asp-action="ProcessSettlement" method="post">
                    <input type="hidden" asp-for="ClaimId" />

                    <div class="mb-4">
                        <label class="form-label">Final Approved Settlement Amount <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text text-success fw-700">$</span>
                            <input asp-for="SettlementAmount" type="number" step="0.01"
                                   class="form-control fw-700 text-success"
                                   style="border-color:#10b981!important;" required />
                        </div>
                        <p class="text-muted mt-1 mb-0" style="font-size:.78rem;">Ensure this matches the Surveyor's assessed cost unless overridden.</p>
                        <span asp-validation-for="SettlementAmount" class="text-danger" style="font-size:.8rem;"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Final Verdict <span class="text-danger">*</span></label>
                        <select name="FinalStatus" class="form-select fw-700" required>
                            <option value="">— Select Decision —</option>
                            <option value="Settled" class="text-success">Approve &amp; Issue Payment</option>
                            <option value="Rejected" class="text-danger">Reject Claim</option>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Final Authorization Remarks</label>
                        <textarea name="OfficerRemarks" class="form-control" rows="3"
                                  placeholder="Add any final notes for the permanent record..."></textarea>
                    </div>

                    <button type="submit" class="btn btn-brand w-100 fw-bold py-3">
                        <i class="fa-solid fa-file-signature me-2"></i> Authorize &amp; Close Claim
                    </button>
                </form>

            </div>
        </div>
    </div>
</div>
