@model Final_Insure.DTOs.CreateClaimDTO
@{
    ViewData["Title"] = "File a Claim";
}

<div class="row justify-content-center">
    <div class="col-lg-9 col-xl-8">
        <div class="card card-shadow-md overflow-hidden">
            <div class="card-header text-white" style="background:linear-gradient(135deg,#0c387a,#1856b5); border-bottom:none!important;">
                <h5 class="mb-0 fw-700 text-white">
                    <i class="fa-solid fa-file-medical me-2"></i> Register a New Claim
                </h5>
            </div>
            <div class="card-body p-4">

                <form asp-action="FileClaim" method="post" enctype="multipart/form-data">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="PolicyId" class="form-label">Select Policy <span class="text-danger">*</span></label>
                            <select asp-for="PolicyId" class="form-select" required>
                                <option value="">— Choose Active Policy —</option>
                                @if (ViewBag.ActivePolicies != null)
                                {
                                    foreach (var policy in ViewBag.ActivePolicies)
                                    {
                                        <option value="@policy.PolicyId">@policy.PolicyType — @policy.PolicyNumber</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="PolicyId" class="text-danger" style="font-size:.8rem;"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ClaimType" class="form-label">Type of Claim <span class="text-danger">*</span></label>
                            <select asp-for="ClaimType" class="form-select" required>
                                <option value="">— Select —</option>
                                <option value="Accident">Accident</option>
                                <option value="Theft">Theft</option>
                                <option value="Natural Disaster">Natural Disaster</option>
                                <option value="Other">Other</option>
                            </select>
                            <span asp-validation-for="ClaimType" class="text-danger" style="font-size:.8rem;"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="ClaimAmount" class="form-label">Requested Amount ($) <span class="text-danger">*</span></label>
                            <input asp-for="ClaimAmount" type="number" step="0.01" class="form-control" placeholder="e.g. 1500.00" required />
                            <span asp-validation-for="ClaimAmount" class="text-danger" style="font-size:.8rem;"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="IncidentDate" class="form-label">Date of Incident <span class="text-danger">*</span></label>
                            <input asp-for="IncidentDate" type="date" class="form-control" required />
                            <span asp-validation-for="IncidentDate" class="text-danger" style="font-size:.8rem;"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AccidentAddress" class="form-label">Accident Location / Address <span class="text-danger">*</span></label>
                        <input asp-for="AccidentAddress" class="form-control" placeholder="123 Main St, City, State" required />
                        <span asp-validation-for="AccidentAddress" class="text-danger" style="font-size:.8rem;"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label">Incident Description <span class="text-danger">*</span></label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Please describe exactly what happened..." required></textarea>
                        <span asp-validation-for="Description" class="text-danger" style="font-size:.8rem;"></span>
                    </div>

                    <div class="p-3 rounded-3 border mb-4" style="background:#f8fafc;">
                        <h6 class="fw-700 mb-3">
                            <i class="bi bi-paperclip me-2 text-muted"></i> Required Evidence &amp; Documents
                        </h6>
                        <div class="mb-3">
                            <label asp-for="DamagePhoto" class="form-label">Damage Photo (JPG/PNG) <span class="text-danger">*</span></label>
                            <input asp-for="DamagePhoto" type="file" class="form-control" accept="image/*" required />
                            <span asp-validation-for="DamagePhoto" class="text-danger" style="font-size:.8rem;"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="FIRDocument" class="form-label">Police FIR (PDF/Image) <span class="text-danger">*</span></label>
                            <input asp-for="FIRDocument" type="file" class="form-control" accept=".pdf,image/*" required />
                            <span asp-validation-for="FIRDocument" class="text-danger" style="font-size:.8rem;"></span>
                        </div>
                        <div class="mb-1">
                            <label asp-for="GarageReceipt" class="form-label">Garage Estimate / Receipt <span class="text-muted fw-400">(Optional)</span></label>
                            <input asp-for="GarageReceipt" type="file" class="form-control" accept=".pdf,image/*" />
                            <span asp-validation-for="GarageReceipt" class="text-danger" style="font-size:.8rem;"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-action="Dashboard" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-brand px-5 fw-bold py-2">
                            <i class="fa-solid fa-paper-plane me-2"></i> Submit Claim
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>
