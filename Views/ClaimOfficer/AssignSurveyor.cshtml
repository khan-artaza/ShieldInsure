@model Final_Insure.DTOs.AssignSurveyorDTO
@using Final_Insure.Models
@{
    ViewData["Title"] = "Assign Surveyor";
    var surveyors = ViewBag.Surveyors as IEnumerable<User>;
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="card card-shadow-md overflow-hidden">
            <div class="card-header text-white"
                 style="background:linear-gradient(135deg,#0c387a,#1856b5); border-bottom:none!important;">
                <h5 class="mb-0 fw-700">
                    <i class="fa-solid fa-user-check me-2"></i> Assign Surveyor to Claim #@Model.ClaimId
                </h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="AssignSurveyor" method="post">
                    <input type="hidden" asp-for="ClaimId" />

                    <div class="mb-3">
                        <label asp-for="SurveyorId" class="form-label">Select Surveyor <span class="text-danger">*</span></label>
                        <select asp-for="SurveyorId" class="form-select">
                            <option value="">— Choose a Surveyor —</option>
                            @if (surveyors != null)
                            {
                                foreach (var surveyor in surveyors)
                                {
                                    <option value="@surveyor.UserId">@surveyor.Username (@surveyor.Email)</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="SurveyorId" class="text-danger" style="font-size:.8rem;"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="OfficerNotes" class="form-label">Instructions for Surveyor</label>
                        <textarea asp-for="OfficerNotes" class="form-control" rows="3"
                                  placeholder="E.g., Please inspect the front bumper..."></textarea>
                        <span asp-validation-for="OfficerNotes" class="text-danger" style="font-size:.8rem;"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-action="Dashboard" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn fw-bold px-4 py-2 shadow-sm text-white"
                                style="background:#f97316;">
                            Assign Claim <i class="fa-solid fa-paper-plane ms-2"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
