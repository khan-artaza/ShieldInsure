@model IEnumerable<Final_Insure.Models.Claim>
@using Final_Insure.Models
@{
    ViewData["Title"] = "My Dashboard";
    var myPolicies    = ViewBag.Policies as IEnumerable<Policy>;
    var settledClaims = Model?.Where(c => c.ClaimStatus == ClaimStatus.Settled).ToList();
    var assessments   = ViewBag.Assessments as List<Final_Insure.Models.Assessment> ?? new List<Final_Insure.Models.Assessment>();
}

<style>
.cust-stat {
    border-radius: 16px; border: 1px solid #e8eef5;
    background: #fff; padding: 1.4rem 1.6rem;
    display: flex; align-items: center; gap: 1rem;
    transition: all .22s ease; box-shadow: 0 1px 6px rgba(0,0,0,.04);
}
.cust-stat:hover { box-shadow: 0 8px 28px rgba(12,56,122,.10); transform: translateY(-3px); }
.cust-stat-icon { width: 52px; height: 52px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; flex-shrink: 0; }
.cust-stat-label { font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: #64748b; margin-bottom: 3px; }
.cust-stat-value { font-size: 2rem; font-weight: 900; line-height: 1; color: #0f172a; }

.data-card { border-radius: 16px; border: 1px solid #e8eef5; background: #fff; overflow: hidden; margin-bottom: 1.4rem; box-shadow: 0 1px 6px rgba(0,0,0,.04); }
.data-card-hdr { display: flex; align-items: center; justify-content: space-between; padding: .9rem 1.25rem; border-bottom: 1px solid #f1f5f9; }
.data-card-title { font-size: .875rem; font-weight: 700; display: flex; align-items: center; gap: 8px; margin: 0; }
.data-card-icon { width: 30px; height: 30px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: .85rem; flex-shrink: 0; }
</style>

<!-- ── WELCOME HEADER ── -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 pb-3" style="border-bottom:1px solid #e8eef5;">
    <div>
        <span class="badge rounded-pill px-3 py-1 mb-2 fw-700 d-inline-block"
              style="background:linear-gradient(135deg,#eff6ff,#dbeafe);color:#0c387a;border:1px solid #bfdbfe;font-size:.7rem;letter-spacing:.07em;">
            CLIENT PORTAL
        </span>
        <h1 style="font-size:1.6rem;font-weight:900;letter-spacing:-.5px;margin:0;">My Insurance Hub</h1>
        <p style="font-size:.875rem;color:#94a3b8;margin:4px 0 0;">Monitor your active policies and claim statuses in real time.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="BuyPolicy"
           style="display:inline-flex;align-items:center;gap:7px;background:linear-gradient(135deg,#0c387a,#1a56c4);color:#fff;font-weight:700;font-size:.875rem;padding:10px 20px;border-radius:10px;text-decoration:none;transition:all .2s;box-shadow:0 4px 14px rgba(12,56,122,.3);">
            <i class="fa-solid fa-shield-plus"></i> New Policy
        </a>
        <a asp-action="FileClaim"
           style="display:inline-flex;align-items:center;gap:7px;background:#fff;color:#dc2626;font-weight:700;font-size:.875rem;padding:10px 20px;border-radius:10px;text-decoration:none;border:1.5px solid #fecaca;transition:all .2s;">
            <i class="fa-solid fa-file-medical"></i> File Claim
        </a>
    </div>
</div>

<!-- ── STAT CARDS ── -->
<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="cust-stat">
            <div class="cust-stat-icon" style="background:#eff6ff;color:#0c387a;">
                <i class="fa-solid fa-shield-check"></i>
            </div>
            <div>
                <div class="cust-stat-label">Active Policies</div>
                <div class="cust-stat-value">@(myPolicies?.Count() ?? 0)</div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="cust-stat">
            <div class="cust-stat-icon" style="background:#fff7ed;color:#ea580c;">
                <i class="fa-solid fa-folder-open"></i>
            </div>
            <div>
                <div class="cust-stat-label">Total Claims</div>
                <div class="cust-stat-value" style="color:#ea580c;">@(Model?.Count() ?? 0)</div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="cust-stat">
            <div class="cust-stat-icon" style="background:#ecfdf5;color:#059669;">
                <i class="fa-solid fa-circle-dollar-to-slot"></i>
            </div>
            <div>
                <div class="cust-stat-label">Settled Payouts</div>
                <div class="cust-stat-value" style="color:#059669;">@(settledClaims?.Count() ?? 0)</div>
            </div>
        </div>
    </div>
</div>

<!-- ── MY ACTIVE POLICIES ── -->
<div class="data-card">
    <div class="data-card-hdr">
        <h6 class="data-card-title">
            <div class="data-card-icon" style="background:#eff6ff;">
                <i class="fa-solid fa-shield-check" style="color:#0c387a;font-size:.8rem;"></i>
            </div>
            My Active Policies
        </h6>
        <span class="badge rounded-pill px-3 py-1 fw-700" style="background:#eff6ff;color:#0c387a;border:1px solid #bfdbfe;font-size:.7rem;">Protected</span>
    </div>
    @if (myPolicies != null && myPolicies.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead><tr>
                    <th class="ps-4">Policy Number</th><th>Type</th>
                    <th>Coverage</th><th>Premium</th>
                    <th>Status</th><th class="text-end pe-4">Action</th>
                </tr></thead>
                <tbody>
                @foreach (var policy in myPolicies)
                {
                    <tr>
                        <td class="ps-4"><span class="fw-800" style="font-family:monospace;font-size:.85rem;color:#0c387a;">@policy.PolicyNumber</span></td>
                        <td class="fw-600">@policy.PolicyType</td>
                        <td style="color:#059669;font-weight:700;">$@policy.CoverageAmount.ToString("N0")</td>
                        <td>$@policy.PremiumAmount.ToString("0.00") <span style="color:#94a3b8;font-size:.78rem;">/mo</span></td>
                        <td>
                            <span class="badge rounded-pill px-3 py-1" style="background:#ecfdf5;color:#059669;border:1px solid #a7f3d0;font-size:.75rem;font-weight:700;">
                                <i class="fa-solid fa-circle-dot me-1" style="font-size:.55rem;"></i>Active
                            </span>
                        </td>
                        <td class="text-end pe-4">
                            <a asp-action="ViewPolicy" asp-route-id="@policy.PolicyId"
                               style="display:inline-flex;align-items:center;gap:5px;padding:5px 12px;border-radius:7px;font-size:.78rem;font-weight:700;background:#f1f5f9;color:#334155;text-decoration:none;border:1px solid #e2e8f0;">
                                View Details
                            </a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="fa-solid fa-shield-exclamation empty-state-icon" style="color:#bfdbfe;"></i>
            <p class="empty-state-title">No Active Policies</p>
            <p class="empty-state-text">You don't have any active policies. Protect your vehicle today.</p>
        </div>
    }
</div>

<!-- ── MY CLAIM HISTORY ── -->
<div class="data-card">
    <div class="data-card-hdr">
        <h6 class="data-card-title">
            <div class="data-card-icon" style="background:#fff7ed;">
                <i class="fa-solid fa-folder-open" style="color:#ea580c;font-size:.8rem;"></i>
            </div>
            My Claim History
        </h6>
        <span class="badge rounded-pill px-3 py-1 fw-700" style="background:#fff7ed;color:#ea580c;border:1px solid #fed7aa;font-size:.7rem;">History</span>
    </div>
    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead><tr>
                    <th class="ps-4">Claim ID</th><th>Date</th>
                    <th>Type</th><th>Amount</th>
                    <th>Status</th><th class="text-end pe-4">Action</th>
                </tr></thead>
                <tbody>
                @foreach (var claim in Model.OrderByDescending(c => c.SubmittedAt))
                {
                    <tr>
                        <td class="ps-4"><span class="fw-800" style="font-family:monospace;font-size:.85rem;color:#0f172a;">#CLM-@claim.ClaimId.ToString("D4")</span></td>
                        <td style="color:#64748b;font-size:.875rem;">@claim.IncidentDate.ToString("MMM dd, yyyy")</td>
                        <td><span class="badge rounded-pill px-2 py-1" style="background:#f1f5f9;color:#475569;font-size:.75rem;">@claim.ClaimType</span></td>
                        <td class="fw-700">$@claim.ClaimAmount.ToString("N0")</td>
                        <td>
                            <span class="badge rounded-pill px-3 py-1" style="background:#eff6ff;color:#0c387a;border:1px solid #bfdbfe;font-size:.75rem;font-weight:700;">@claim.ClaimStatus</span>
                        </td>
                        <td class="text-end pe-4">
                            <a asp-action="ViewClaim" asp-route-id="@claim.ClaimId"
                               style="display:inline-flex;align-items:center;gap:5px;padding:5px 12px;border-radius:7px;font-size:.78rem;font-weight:700;background:#f1f5f9;color:#334155;text-decoration:none;border:1px solid #e2e8f0;">
                                View Claim
                            </a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="fa-solid fa-file-circle-question empty-state-icon" style="color:#fed7aa;"></i>
            <p class="empty-state-title">No Claims Filed</p>
            <p class="empty-state-text">You have not filed any claims yet.</p>
        </div>
    }
</div>

<!-- ── PAYMENT & SETTLEMENT HISTORY ── -->
<div class="data-card">
    <div class="data-card-hdr">
        <h6 class="data-card-title">
            <div class="data-card-icon" style="background:#ecfdf5;">
                <i class="fa-solid fa-circle-dollar-to-slot" style="color:#059669;font-size:.8rem;"></i>
            </div>
            Payment &amp; Settlement History
        </h6>
        <span class="badge rounded-pill px-3 py-1 fw-700" style="background:#ecfdf5;color:#059669;border:1px solid #a7f3d0;font-size:.7rem;">Completed</span>
    </div>
    @if (settledClaims != null && settledClaims.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead><tr>
                    <th class="ps-4">Claim Reference</th>
                    <th>Settlement Date</th>
                    <th>Approved Amount</th>
                    <th class="text-end pe-4">Action</th>
                </tr></thead>
                <tbody>
                @foreach (var settlement in settledClaims)
                {
                    var linkedAssessment = assessments.FirstOrDefault(a => a.ClaimId == settlement.ClaimId);
                    decimal finalDisplayAmount = linkedAssessment != null ? linkedAssessment.AssessedAmount : settlement.ClaimAmount;
                    <tr>
                        <td class="ps-4"><span class="fw-800" style="font-family:monospace;font-size:.85rem;color:#059669;">#CLM-@settlement.ClaimId.ToString("D4")</span></td>
                        <td style="color:#64748b;font-size:.875rem;">@(settlement.IncidentDate.ToString("MMM dd, yyyy"))</td>
                        <td><span class="fw-800 text-success" style="font-size:1rem;">$@finalDisplayAmount.ToString("N0")</span></td>
                        <td class="text-end pe-4">
                            <a asp-controller="Customer" asp-action="PaymentReceipt" asp-route-claimId="@settlement.ClaimId"
                               style="display:inline-flex;align-items:center;gap:5px;padding:5px 14px;border-radius:7px;font-size:.78rem;font-weight:700;background:#059669;color:#fff;text-decoration:none;">
                                <i class="fa-solid fa-download"></i> Receipt
                            </a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="fa-solid fa-receipt empty-state-icon" style="color:#a7f3d0;"></i>
            <p class="empty-state-title">No Payment History</p>
            <p class="empty-state-text">When your claims are approved and paid, the receipts will appear here.</p>
        </div>
    }
</div>
