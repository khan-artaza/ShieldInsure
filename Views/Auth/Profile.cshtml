@model Final_Insure.Models.User

@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header text-white" style="background: linear-gradient(135deg, #0c387a, #1856b5);">
                    <h5 class="mb-0"><i class="bi bi-person-circle me-2"></i> User Profile</h5>
                </div>
                <div class="card-body p-4">

                    <div class="text-center mb-4">
                        <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center text-primary border" style="width: 80px; height: 80px; font-size: 2rem;">
                            @Model.Username.Substring(0, 1).ToUpper()
                        </div>
                        <h4 class="mt-3 fw-bold">@Model.Username</h4>
                        <span class="badge bg-secondary">@Model.Role</span>
                    </div>

                    <ul class="list-group list-group-flush mb-4">
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <strong>Email Address:</strong>
                            <span class="text-muted">@Model.Email</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <strong>Account Status:</strong>
                            @if (Model.IsApproved)
                            {
                                <span class="badge bg-success">Active & Verified</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Pending Approval</span>
                            }
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <strong>Member Since:</strong>
                            <span class="text-muted">@Model.CreatedAt.ToString("MMMM dd, yyyy")</span>
                        </li>
                    </ul>

                    <!-- This takes them back to their specific dashboard based on their role -->
                    <div class="d-grid">
                        <a href="javascript:history.back()" class="btn btn-outline-primary fw-bold">Back to Dashboard</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>