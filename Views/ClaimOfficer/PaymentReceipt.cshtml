@model Final_Insure.Models.Claim
@{
    ViewData["Title"] = "Settlement Receipt";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="card card-shadow-lg overflow-hidden shadow-sm">

            <!-- Restored the stacked layout, but kept padding balanced (py-4) -->
            <div class="receipt-header py-4 text-center" style="background: linear-gradient(135deg, #198754, #146c43);">
                <i class="fa-solid fa-circle-check text-white mb-2" style="font-size:2.75rem; opacity:.9;"></i>
                <h4 class="fw-bold mb-1 text-white">Claim Settled Successfully</h4>
                <p class="mb-0 text-white opacity-75" style="font-size:0.95rem;">Transaction Receipt</p>
            </div>

            <!-- Comfortable padding (p-4) instead of the oversized (p-5) or squished (p-2) -->
            <div class="card-body p-4">
                
                <div class="row mb-3">
                    <div class="col-6">
                        <p class="text-muted mb-1" style="font-size:.75rem; font-weight:700; text-transform:uppercase; letter-spacing:.05em;">Reference ID</p>
                        <h6 class="fw-bold mb-0">#CLM-@Model.ClaimId.ToString("D4")</h6>
                    </div>
                    <div class="col-6 text-end">
                        <p class="text-muted mb-1" style="font-size:.75rem; font-weight:700; text-transform:uppercase; letter-spacing:.05em;">Settlement Date</p>
                        <h6 class="fw-bold mb-0">@(Model.IncidentDate.ToString("MMM dd, yyyy"))</h6>
                    </div>
                </div>

                <hr class="my-3 opacity-25">

                <!-- Clean, readable list spacing with mb-3 -->
                <div class="detail-row d-flex justify-content-between mb-3">
                    <span class="detail-label text-muted">Requested Amount</span>
                    <span class="detail-value fw-bold">$@Model.ClaimAmount.ToString("N0")</span>
                </div>
                <div class="detail-row d-flex justify-content-between mb-3">
                    <span class="detail-label text-muted">Claim Type</span>
                    <span class="detail-value fw-semibold">@Model.ClaimType</span>
                </div>
                <div class="detail-row d-flex justify-content-between mb-4 align-items-center">
                    <span class="detail-label text-muted">Final Status</span>
                    <span class="detail-value">
                        <span class="badge badge-soft-success rounded-pill px-3 py-1">@Model.ClaimStatus</span>
                    </span>
                </div>

                <!-- Highlighted Total Box -->
                <div class="receipt-total-box p-3 rounded bg-light border d-flex justify-content-between align-items-center mb-4">
                    <span class="fw-bold text-muted">Approved Payout</span>
                    <h3 class="mb-0 fw-bold text-success">$@Model.ClaimAmount.ToString("N0")</h3>
                </div>

                <!-- Restored standard button sizes and a nice top border separator -->
                <div class="text-center border-top pt-4 d-flex gap-3 justify-content-center flex-wrap">
                    <button onclick="window.print()" class="btn btn-outline-dark fw-bold px-4 py-2 shadow-sm">
                        <i class="fa-solid fa-print me-2"></i> Print
                    </button>
                    <a asp-action="Dashboard" class="btn btn-brand fw-bold px-4 py-2">
                        <i class="fa-solid fa-house me-2"></i> Dashboard
                    </a>
                </div>
                
            </div>
        </div>
    </div>
</div>