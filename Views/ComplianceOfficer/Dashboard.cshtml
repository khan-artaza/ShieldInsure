@model IEnumerable<Final_Insure.Models.Claim>
@{
    ViewData["Title"] = "Compliance Dashboard";
    int pendingCount = Model?.Count() ?? 0;
}

<style>
.comp-stat { border-radius:16px;border:1px solid #e8eef5;background:#fff;padding:1.4rem 1.6rem;display:flex;align-items:center;gap:1rem;transition:all .22s ease;box-shadow:0 1px 6px rgba(0,0,0,.04); }
.comp-stat:hover { box-shadow:0 8px 28px rgba(79,70,229,.12);transform:translateY(-3px); }
.comp-stat-icon { width:52px;height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:1.3rem;flex-shrink:0; }
.comp-stat-label { font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:#64748b;margin-bottom:3px; }
.comp-stat-value { font-size:2rem;font-weight:900;line-height:1;color:#0f172a; }
.comp-stage-card { border-radius:16px;border:1px solid #e8eef5;background:#fff;overflow:hidden;box-shadow:0 1px 6px rgba(0,0,0,.04); }
.comp-stage-hdr { display:flex;align-items:center;justify-content:space-between;padding:.9rem 1.25rem;border-bottom:1px solid #f1f5f9; }
</style>

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-header-title" style="display:flex;align-items:center;gap:.5rem;">
            <span style="display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;background:linear-gradient(135deg,#4f46e5,#6366f1);border-radius:10px;">
                <i class="fa-solid fa-user-shield text-white" style="font-size:.9rem;"></i>
            </span>
            Compliance &amp; Fraud Dept
        </h1>
        <p class="page-header-subtitle">Review surveyor assessments and execute background fraud checks.</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="comp-stat">
            <div class="comp-stat-icon" style="background:rgba(79,70,229,.1);color:#4f46e5;">
                <i class="fa-solid fa-magnifying-glass-chart"></i>
            </div>
            <div>
                <div class="comp-stat-label">Awaiting Check</div>
                <div class="comp-stat-value" style="color:#4f46e5;">@pendingCount</div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="comp-stat">
            <div class="comp-stat-icon" style="background:#fff7ed;color:#ea580c;">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <div>
                <div class="comp-stat-label">High Risk Flags</div>
                <div class="comp-stat-value" style="color:#ea580c;">0</div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="comp-stat">
            <div class="comp-stat-icon" style="background:#ecfdf5;color:#059669;">
                <i class="fa-solid fa-shield-check"></i>
            </div>
            <div>
                <div class="comp-stat-label">Cleared Today</div>
                <div class="comp-stat-value" style="color:#059669;">0</div>
            </div>
        </div>
    </div>
</div>

<!-- Fraud Check Table -->
<div class="comp-stage-card">
    <div class="comp-stage-hdr">
        <h6 style="font-size:.875rem;font-weight:700;display:flex;align-items:center;gap:8px;margin:0;">
            <span style="width:30px;height:30px;border-radius:8px;background:rgba(79,70,229,.1);display:flex;align-items:center;justify-content:center;">
                <i class="fa-solid fa-shield-halved" style="color:#4f46e5;font-size:.8rem;"></i>
            </span>
            Claims Pending Background Check
        </h6>
        @if (pendingCount > 0)
        {
            <span class="badge rounded-pill px-3 py-1 fw-700" style="background:rgba(79,70,229,.1);color:#4f46e5;border:1px solid rgba(79,70,229,.25);font-size:.72rem;">
                @pendingCount Pending
            </span>
        }
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead><tr>
                    <th class="ps-4">Claim ID</th>
                    <th>Incident Date</th>
                    <th>Requested Amount</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Action</th>
                </tr></thead>
                <tbody>
                @foreach (var claim in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <span class="fw-800" style="font-family:monospace;font-size:.85rem;color:#4f46e5;">#CLM-@claim.ClaimId.ToString("D4")</span>
                        </td>
                        <td style="color:#64748b;font-size:.875rem;">@claim.IncidentDate.ToString("MMM dd, yyyy")</td>
                        <td class="fw-700">$@claim.ClaimAmount.ToString("N0")</td>
                        <td>
                            <span class="badge rounded-pill px-3 py-1" style="background:rgba(79,70,229,.1);color:#4f46e5;border:1px solid rgba(79,70,229,.25);font-size:.75rem;font-weight:700;">
                                @claim.ClaimStatus
                            </span>
                        </td>
                        <td class="text-end pe-4">
                            <a asp-action="SubmitFraudCheck" asp-route-claimId="@claim.ClaimId"
                               style="display:inline-flex;align-items:center;gap:5px;padding:6px 14px;border-radius:8px;font-size:.8rem;font-weight:700;background:#4f46e5;color:#fff;text-decoration:none;transition:all .2s;">
                                <i class="fa-solid fa-user-shield"></i> Run Fraud Check
                            </a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="fa-solid fa-clipboard-check empty-state-icon" style="color:rgba(79,70,229,.3);"></i>
            <p class="empty-state-title">All Clear!</p>
            <p class="empty-state-text">There are no claims currently waiting for a fraud check.</p>
        </div>
    }
</div>
