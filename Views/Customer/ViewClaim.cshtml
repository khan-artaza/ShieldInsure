@model Final_Insure.Models.Claim

@{
    ViewData["Title"] = "Claim Details";
}

<div class="container mt-5">
    <div class="row">
        <!-- Claim Details Left Side -->
        <div class="col-md-7 mb-4">
            <div class="card shadow-sm border-0 rounded-3 h-100">
                <div class="card-header text-white bg-dark">
                    <h5 class="mb-0">Claim Record: #CLM-@Model.ClaimId.ToString("D4")</h5>
                </div>
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">Incident Overview</h5>
                    <p><strong>Date:</strong> @Model.IncidentDate.ToString("MMM dd, yyyy")</p>
                    <p><strong>Location:</strong> @Model.AccidentAddress</p>
                    <p><strong>Type:</strong> @Model.ClaimType</p>
                    <p><strong>Requested Payout:</strong> <span class="text-success fw-bold">$@Model.ClaimAmount.ToString("N0")</span></p>

                    <hr />
                    <h5 class="fw-bold mb-2">Description</h5>
                    <p class="text-muted border p-3 rounded bg-light">@Model.Description</p>

                    <a asp-action="Dashboard" class="btn btn-outline-secondary mt-3">Back to Dashboard</a>
                </div>
            </div>
        </div>

        <!-- Uploaded Evidence Right Side -->
        <div class="col-md-5 mb-4">
            <div class="card shadow-sm border-0 rounded-3 h-100">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0"><i class="bi bi-paperclip"></i> Uploaded Evidence</h5>
                </div>
                <div class="card-body p-4">
                    @if (Model.ClaimDocuments != null && Model.ClaimDocuments.Any())
                    {
                        <div class="list-group">
                            @foreach (var doc in Model.ClaimDocuments)
                            {
                                <a href="@doc.FilePath" target="_blank" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>@doc.DocumentName</strong><br />
                                        <small class="text-muted">Uploaded: @doc.UploadedAt.ToString("MMM dd")</small>
                                    </div>
                                    <span class="badge bg-primary rounded-pill"><i class="bi bi-eye"></i> View</span>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No documents were uploaded with this claim.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>