@model Final_Insure.Models.Claim
@{
    ViewData["Title"] = "Vehicle Inspection Form";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <div>
        <h1 class="page-header-title">Vehicle Inspection: #CLM-@Model.ClaimId.ToString("D4")</h1>
        <p class="page-header-subtitle">Verify the damage, check for fraud, and submit your official repair estimate.</p>
    </div>
    <a asp-action="Dashboard" class="btn btn-outline-secondary fw-600">
        <i class="fa-solid fa-arrow-left me-2"></i> Cancel
    </a>
</div>

<div class="row g-4">
    <!-- Left: Read-Only Claim Report -->
    <div class="col-lg-5">
        <div class="card card-shadow-md overflow-hidden h-100">
            <div class="card-header bg-dark text-white" style="border-bottom:none!important;">
                <h5 class="mb-0 fw-700 text-white">
                    <i class="fa-solid fa-file-invoice me-2"></i> Customer's Claim Report
                </h5>
            </div>
            <div class="card-body p-4" style="background:#f8fafc;">
                <div class="detail-row">
                    <span class="detail-label">Incident Date</span>
                    <span class="detail-value">@Model.IncidentDate.ToString("MMM dd, yyyy")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Location</span>
                    <span class="detail-value text-muted">@Model.AccidentAddress</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Claim Type</span>
                    <span class="detail-value fw-600">@Model.ClaimType</span>
                </div>

                <hr class="opacity-25 my-3">
                <p class="text-muted fw-700 mb-2" style="font-size:.78rem; text-transform:uppercase; letter-spacing:.06em;">Customer Description</p>
                <div class="p-3 border rounded-3 bg-white mb-4">
                    <span class="text-muted" style="font-size:.875rem;">@Model.Description</span>
                </div>

                <div class="p-3 border rounded-3 text-center" style="background:rgba(12,56,122,.06);">
                    <span class="d-block text-muted fw-700 mb-1" style="font-size:.72rem; text-transform:uppercase; letter-spacing:.06em;">Amount Requested</span>
                    <h2 class="mb-0 fw-800 text-brand">$@Model.ClaimAmount.ToString("N0")</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Right: Assessment Form -->
    <div class="col-lg-7">
        <div class="card card-shadow-lg overflow-hidden">
            <div class="card-header text-white" style="background:#00897b; border-bottom:none!important;">
                <h5 class="mb-0 fw-700 text-white">
                    <i class="fa-solid fa-clipboard-check me-2"></i> Official Assessment Form
                </h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="SubmitAssessment" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="ClaimId" value="@Model.ClaimId" />

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Actual Car Number Verified <span class="text-danger">*</span></label>
                            <input type="text" name="CarNumber" class="form-control" placeholder="e.g. MH 01 AB 1234" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Garage / Workshop Details</label>
                            <input type="text" name="GarageDetails" class="form-control" placeholder="Name of garage repairing vehicle" />
                        </div>
                    </div>

                    <!-- Fraud Check -->
                    <div class="mb-4 p-3 border rounded-3" style="background:#fffbeb; border-color:#fcd34d!important;">
                        <label class="form-label fw-700 text-dark mb-3">
                            <i class="fa-solid fa-shield-halved text-warning me-2"></i>
                            Fraud Check: Does the physical damage match the customer's description?
                            <span class="text-danger">*</span>
                        </label>
                        <div class="d-flex gap-4">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="AccidentMatchesDescription" id="matchYes" value="true" required>
                                <label class="form-check-label fw-700 text-success" for="matchYes">
                                    <i class="fa-solid fa-thumbs-up me-1"></i> Yes, it matches
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="AccidentMatchesDescription" id="matchNo" value="false">
                                <label class="form-check-label fw-700 text-danger" for="matchNo">
                                    <i class="fa-solid fa-triangle-exclamation me-1"></i> No, suspicious
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Estimated Repair Cost (Assessed Amount) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text fw-700">$</span>
                            <input type="number" step="0.01" name="AssessedAmount"
                                   class="form-control fw-700"
                                   style="border-color:#0c387a!important;"
                                   placeholder="Enter actual repair cost" required />
                        </div>
                        <p class="text-muted mt-1 mb-0" style="font-size:.78rem;">
                            Compare to the customer's requested amount of $@Model.ClaimAmount.ToString("N0").
                        </p>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Upload Inspection Photo <span class="text-danger">*</span></label>
                        <input type="file" name="EvidencePhoto" class="form-control" accept="image/*" required />
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Additional Remarks</label>
                        <textarea name="AssessmentRemarks" class="form-control" rows="3"
                                  placeholder="Notes for the Claim Officer..."></textarea>
                    </div>

                    <button type="submit" class="btn w-100 fw-bold py-3 text-white"
                            style="background:#00897b;">
                        Submit Assessment Report <i class="fa-solid fa-check-double ms-2"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
