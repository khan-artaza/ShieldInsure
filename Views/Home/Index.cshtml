<!-- ════════════════════════════════════════════════
     HOW IT WORKS
═════════════════════════════════════════════════ -->
<section class="light-section py-5" id="how-it-works" style="padding-top:6rem!important;padding-bottom:6rem!important;">
    <div class="container">
        <div class="text-center mb-5">
            <div class="section-eyebrow justify-content-center">Transparent Workflow</div>
            <h2 class="section-title">Simple 3-Step Claim Process</h2>
            <p class="text-muted mt-3" style="font-size:.95rem;">Track your claim at every single stage from your customer portal.</p>
        </div>
        <div class="row g-4">
            <div class="col-lg-4">
                <div class="process-card">
                    <div class="process-num">01</div>
                    <div class="feat-icon mb-3" style="background:#eff6ff; color:#0c387a;">
                        <i class="fa-solid fa-file-pen"></i>
                    </div>
                    <h5 class="fw-800 mb-2">Register Claim</h5>
                    <p class="text-muted mb-0" style="font-size:.875rem; line-height:1.7;">Log in to your customer dashboard and submit your incident report along with damage photos.</p>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="process-card">
                    <div class="process-num">02</div>
                    <div class="feat-icon mb-3" style="background:#fff7ed; color:#ea580c;">
                        <i class="fa-solid fa-magnifying-glass-location"></i>
                    </div>
                    <h5 class="fw-800 mb-2">Field Inspection</h5>
                    <p class="text-muted mb-0" style="font-size:.875rem; line-height:1.7;">A certified survey officer inspects your vehicle and submits a verified damage report.</p>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="process-card step-final">
                    <div class="process-num">03</div>
                    <div class="feat-icon mb-3" style="background:rgba(16,185,129,.15); color:#059669;">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                    <h5 class="fw-800 mb-2">Automated Payout</h5>
                    <p class="text-muted mb-0" style="font-size:.875rem; line-height:1.7;">Once cleared by compliance and approved, funds are transferred directly to your bank account.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ════════════════════════════════════════════════
     FAQ
═════════════════════════════════════════════════ -->
<section class="light-section-alt py-5" id="faq" style="padding-top:6rem!important;padding-bottom:6rem!important;">
    <div class="container">
        <div class="text-center mb-5">
            <div class="section-eyebrow justify-content-center">Help &amp; Support</div>
            <h2 class="section-title">Frequently Asked Questions</h2>
        </div>
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="accordion faq-accordion shadow-sm rounded-4 overflow-hidden" id="faqAccordion">
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                                How long does it take to process a claim?
                            </button>
                        </h2>
                        <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Most claims are processed and settled within 48 to 72 hours from the date of document submission.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                                What documents are required to file a claim?
                            </button>
                        </h2>
                        <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                You need: Policy Document, Vehicle RC, Driving License, FIR (for theft/third-party), and clear photos of the damage.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item" style="border-bottom:none;">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                                Can I track my claim status online?
                            </button>
                        </h2>
                        <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Yes. Once logged in, navigate to your Dashboard to see real-time updates at every stage of the workflow.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

